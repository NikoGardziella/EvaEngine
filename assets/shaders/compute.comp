#type compute
#version 450
#include "ComputeUtils.glsl"

// ---------- config ----------
#define MAX_TEXTURES            32
#define MAX_COLLISION_ENTITIES  64
#define CHUNK_SIZE              32
#define GRID_WIDTH              3
#define GRID_HEIGHT             3
#define ACTIVE_SLOTS            (GRID_WIDTH * GRID_HEIGHT)
#define SUBTILES_PER_TILE       4
#define PROJ_RADIUS_IS_WORLD    1


// Mode bits
#define MODE_VIZ            1u
#define MODE_IGNORE_Z       2u
#define MODE_FORCE_SOLID    4u
#define MODE_PAINT_WHY      8u
#define MODE_IGNORE_CLAIM  16u
#define MODE_HITSCAN       32u
#define MODE_COLLIDE_GROUND  64u
#define MODE_STRIPE_FILL   128u   // paints stripes across the whole image (proves writes)
#define MODE_SMOKE_HIT     256u // calls brush once at EndPos pixel (proves mapping+brush)

// Bits inside BlockedTileMask[idx]
#define MASK_ALIVE      1u   // bottom-band AND health > 0
#define MASK_DESTROYED  2u   // bottom-band AND transitioned to health == 0 this pass

layout(local_size_x = 16, local_size_y = 16) in;

// ---------- images ----------
layout(set = 0, binding = 0, rgba8)   uniform  image2D  u_InputTexture[ACTIVE_SLOTS];
layout(set = 0, binding = 1, rgba8ui) uniform uimage2D u_PropertiesImage[ACTIVE_SLOTS]; // R=health, G=rowsAbovePivot, B=mask, A=flags

// ---------- results ----------
struct CollisionResult
{
    uint collisionDetected;
    uint hitProjectileID_Low;    // we'll use this as "depth key" scratch
    uint hitProjectileID_High;   // unused for depth
    uint _pad0;
    vec2 CollisionPosition;
    uint HealthAfter;
    uint _pad1;
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer
{
    uint collisionCount;
    uint _padA; uint _padB; uint _padC;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

// ---------- projectile layout (EXACT ORDER) ----------
struct ProjectileGPU
{
    vec2  Position;
    float Radius;
    uint  Type;

    uint  ID_Low;
    uint  ID_High;

    vec2  Size;
    float Rotation;

    uint  Damage;
    uint  DestructionRadius;

    vec2  EndPos;
    vec2  Dir;

    float RayLen;
    float Z1;
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles
{
    ProjectileGPU data[];
};

layout(std430, set = 0, binding = 4) buffer BlockedTileMask
{
    uint blockedMask[];
};

// ---------- push constants ----------
layout(push_constant) uniform PushConstants
{
    vec2  TextureOrigin;   // world bottom-left of this image
    float PixelSize;       // world units per atlas pixel
    uint  textureIndex;    // 0..8

    uint  NumProjectiles;
    uint  ChunkSize;       // pixels per chunk (unused here)
    uint  TileSize;        // pixels per tile
    uint  mode;            // debug bitfield

    ivec2 MinTileCoords;   // reserved (unused here)
} pc;

// ---------- constants ----------
const float GROUND_Z   = 0.0;
const float GROUND_TOL = 0.02;   

// ---------- helpers ----------

uint hashTag(uint lo, uint hi)
{
    uint h = 0x9E3779B9u ^ lo;
    h ^= hi + 0x85EBCA6Bu + (h << 6) + (h >> 2);
    h *= 0xC2B2AE35u;
    h ^= (h >> 16);
    return (h | 1u);
}
uvec4 loadProps(uint slot, ivec2 px)
{
    return imageLoad(u_PropertiesImage[slot], px);
}

void storeProps(uint slot, ivec2 px, uvec4 v)
{
    imageStore(u_PropertiesImage[slot], px, v);
}

void clearColor(uint slot, ivec2 px)
{
    imageStore(u_InputTexture[slot], px, vec4(0.0));
}

bool hasHealth(uvec4 p)
{
    return (p.r > 0u);
}

float heightWorld(uvec4 p)
{
    return float(p.g) * pc.PixelSize; // G = rows-above-pivot
}

// Map world point to the local pixel inside this image's slot
// Returns (ix,iy) that should match gl_GlobalInvocationID.xy when you're over that pixel.
ivec2 worldToLocalPx(vec2 world)
{
    vec2 delta = (world - pc.TextureOrigin) / pc.PixelSize; // in pixels
    // pixelCenter = origin + (ix + 0.5)*px; so invert with -0.5
    ivec2 px = ivec2(floor(delta - vec2(0.5)));
    return px;
}


void writeMaskForSlotPx(uint slot, ivec2 lp, uint bits)
{
    const int tileSizePx     = int(pc.TileSize);
    const int spt            = SUBTILES_PER_TILE;
    const int tilesPerRow    = int(CHUNK_SIZE) * int(GRID_WIDTH);
    const int tilesPerCol    = int(CHUNK_SIZE) * int(GRID_HEIGHT);
    const int subtilesPerRow = tilesPerRow * spt;
    const int subtilesRows   = tilesPerCol * spt;

    ivec2 tileInSlot = lp / tileSizePx;                   // 0..CHUNK_SIZE-1
    ivec2 pxInTile   = lp - tileInSlot * tileSizePx;      // 0..tileSizePx-1

    // ceil-div to avoid last-pixel overflow
    const int pxPerSub = max(1, (tileSizePx + spt - 1) / spt);
    ivec2 subtile = ivec2(pxInTile.x / pxPerSub, pxInTile.y / pxPerSub);
    subtile = clamp(subtile, ivec2(0), ivec2(spt - 1));

    int cx = int(slot % uint(GRID_WIDTH));
    int cy = int(slot / uint(GRID_WIDTH)); // row-major in the 3x3 window

    ivec2 rel = ivec2(cx * CHUNK_SIZE + tileInSlot.x,
                      cy * CHUNK_SIZE + tileInSlot.y) * spt + subtile;

    if (uint(rel.x) < uint(subtilesPerRow) && uint(rel.y) < uint(subtilesRows))
    {
        uint idx = uint(rel.y) * uint(subtilesPerRow) + uint(rel.x);
        atomicOr(blockedMask[idx], bits);
    }
}

void writeBlockedMaskIfNeeded(ivec2 localPx) // usually ivec2(gl_GlobalInvocationID.xy)
{
       writeMaskForSlotPx(pc.textureIndex, localPx, MASK_ALIVE);
}


// distance (world) from point to segment AB
float distPointToSegment(vec2 P, vec2 A, vec2 B)
{
    vec2 AB = B - A;
    float denom = dot(AB, AB);
    float t = (denom > 0.0) ? clamp(dot(P - A, AB) / denom, 0.0, 1.0) : 0.0;
    vec2 C = A + t * AB;
    vec2 d = P - C;
    return sqrt(dot(d, d));
}

// param (0..1) of point projection onto segment A->dir (length = lenAB)
float paramOnSegment(vec2 P, vec2 A, vec2 dir, float lenAB)
{
    float t = dot(P - A, dir) / max(lenAB, 1e-6);
    return clamp(t, 0.0, 1.0);
}

void appendHit(const ProjectileGPU proj, vec2 worldPos, uint healthAfter)
{
    uint idx = atomicAdd(collisionCount, 1u);
    uint dst = pc.NumProjectiles + idx;
    if (dst >= MAX_COLLISION_ENTITIES) return;

    results[dst].collisionDetected    = 1u;
    results[dst].hitProjectileID_Low  = proj.ID_Low;
    results[dst].hitProjectileID_High = proj.ID_High;
    results[dst].CollisionPosition    = worldPos;
    results[dst].HealthAfter          = healthAfter;
}

// IDENTICAL behavior to your previous working shader.
// Wraps by ONE chunk using the current slot's real image size.
void mapToNeighborSlot(ivec2 localPx, ivec2 curTexSize,
                       out uint writeSlot, out ivec2 writePx)
{
    const int gridW = GRID_WIDTH;
    const int gridH = GRID_HEIGHT;

    const int cx = int(pc.textureIndex % uint(gridW));
    const int cy = int(pc.textureIndex / uint(gridW));

    int sx = 0, sy = 0;
    ivec2 p = localPx;

    if      (p.x < 0)              { sx = -1; p.x += curTexSize.x; }
    else if (p.x >= curTexSize.x)  { sx = +1; p.x -= curTexSize.x; }

    if      (p.y < 0)              { sy = -1; p.y += curTexSize.y; }
    else if (p.y >= curTexSize.y)  { sy = +1; p.y -= curTexSize.y; }

    const int nx = cx + sx;
    const int ny = cy + sy;

    if (nx < 0 || nx >= gridW || ny < 0 || ny >= gridH) {
        writeSlot = 0xffffffffu;
        writePx   = ivec2(0);
        return;
    }

    writeSlot = uint(ny * gridW + nx);
    writePx   = p;
}




// Brush-based damage/destruction around the hit pixel.
// - Spills across chunk borders via mapToNeighborSlot
// - Ignores Z for neighbor pixels (keeps round craters on tall sprites)
// One-pass damage + immediate visual impact (no FX pass required)
// --- Brush-based damage/destruction with visible debug overlay ---
void applyDamageBrush(in ProjectileGPU proj,
                      in ivec2 centerPx,
                      in float /*zRayAtCenter*/,
                      in bool  /*forceSol*/,
                      in bool  /*igZ*/)
{
    // Radius in *pixels* (as per your setup)
    int rpx = int(proj.DestructionRadius);
    if (rpx <= 0) return;
    int r2 = rpx * rpx;

    // Optional: radial falloff. Set to false for flat damage.
    const bool useFalloff = true;

    ivec2 curSize = imageSize(u_InputTexture[pc.textureIndex]);

    for (int oy = -rpx; oy <= rpx; ++oy)
    for (int ox = -rpx; ox <= rpx; ++ox)
    {
        int d2 = ox*ox + oy*oy;
        if (d2 > r2) continue;

        ivec2 pLocal = centerPx + ivec2(ox, oy);

        // Handle spill to neighbor slots
        uint  slot;
        ivec2 lp;
        mapToNeighborSlot(pLocal, curSize, slot, lp); 
        if (slot == 0xffffffffu || slot >= ACTIVE_SLOTS) continue;

        ivec2 sz = imageSize(u_InputTexture[slot]);
        if (lp.x < 0 || lp.y < 0 || lp.x >= sz.x || lp.y >= sz.y) continue;

        // Read properties & current color
        uvec4 prop = imageLoad(u_PropertiesImage[slot], lp);
        uint  health = prop.r;

        // If already destroyed, enforce visual clear and keep FX off
        if (health == 0u)
        {
            imageStore(u_InputTexture[slot], lp, vec4(0.0));
            // keep prop.b (fxTimer)=0 and prop.a (prevK)=0
            // (prop.r already 0)
            imageStore(u_PropertiesImage[slot], lp, prop);
            continue;
        }

        // Compute damage to apply (optional falloff)
        uint applyDmg;
        if (useFalloff)
        {
            // linear falloff from center -> rim; minimum 1
            float r = float(rpx);
            float dist01 = clamp(sqrt(float(d2)) / max(r, 1e-6), 0.0, 1.0);
            float scaled = float(proj.Damage) * (1.0 - dist01);
            applyDmg = max(1u, uint(ceil(scaled)));
        }
        else
        {
            applyDmg = max(1u, proj.Damage);
        }

        // Apply damage check
        if (applyDmg >= health)
        {
            // Fully destroyed
            imageStore(u_InputTexture[slot], lp, vec4(0.0)); // clear visual immediately
            prop.r = 0u;      // health
            prop.b = 255u;    // <-- ARM FX for a destruction flash (first-arm sentinel)
            prop.a = 0u;      // prevK reset
            imageStore(u_PropertiesImage[slot], lp, prop);

            writeMaskForSlotPx(slot, lp, MASK_DESTROYED);
        }
        else
        {
            // Partial damage
            prop.r = health - applyDmg;
            prop.b = 255u;          // ARM FX (full-strength sentinel)
            prop.a = 0u;            // prevK
            imageStore(u_PropertiesImage[slot], lp, prop);
        }
    }
}






void main()
{
    if (pc.textureIndex >= ACTIVE_SLOTS)
    {
        return;
    }

    ivec2 localPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(u_InputTexture[pc.textureIndex]);
    if (localPx.x >= imgSize.x || localPx.y >= imgSize.y)
    {
        return;
    }

    // World center of this pixel
    vec2  pixelCenterW = pc.TextureOrigin + (vec2(localPx) + vec2(0.5)) * pc.PixelSize;
    float halfPixW     = 0.5 * pc.PixelSize;

    // Properties at this pixel
    uvec4 props    = loadProps(pc.textureIndex, localPx);
    bool  solidRaw = hasHealth(props);

    uint HeightThresholdPx = 20;
    bool bottomBand  = (props.g <= HeightThresholdPx);
    // Keep writing your blocked mask when a pixel has health
    if (bottomBand  && props.r > 0u)
    {
        writeBlockedMaskIfNeeded(localPx);
    }

    // Mode bits
    const bool viz      = (pc.mode &  1u) != 0u;   // visualize markers
    const bool igZ      = (pc.mode &  2u) != 0u;   // ignore Z gate
    const bool forceSol = (pc.mode &  4u) != 0u;   // force solid
    const bool why      = (pc.mode &  8u) != 0u;   // paint reasons (debug)
    const bool igClaim  = (pc.mode & 16u) != 0u;   // ignore claim
    const bool hitscan  = (pc.mode & 32u) != 0u;   // treat as fully traveled

    // Debug marker sizes (in pixels)
    const float MARKER_RADIUS_PX    = 2.0;
    const float TRAIL_HALF_THICK_PX = 1.5;
    const int   COLLISION_BRUSH_PX  = 2;

    float markerR_W   = MARKER_RADIUS_PX    * pc.PixelSize;
    float trailHalf_W = TRAIL_HALF_THICK_PX * pc.PixelSize;

    // Z gating constants
    const float EPS_Z       = 1e-5;
    const float MIN_SOLID_Z = 0.1 * pc.PixelSize;  // treat tiny G as zero

    // Ground fallback (flat world). Units are world units.
    const float GROUND_Z   = 0.0;
    const float GROUND_TOL = 0.02;

    // Front band around the traveling front
    const float ARM_PX        = 0.0;
    const float BACK_SLACK_PX = 2.0;
    const float LEAD_SLACK_PX = 3.0;


    if ((pc.mode & MODE_STRIPE_FILL) != 0u)
    {
        // diagonal + row stripe pattern in bright yellow
        bool stripe = ((localPx.x ^ localPx.y) & 8) != 0;
        vec4 col = stripe ? vec4(1,1,0,1) : vec4(0,0,0,1);
        imageStore(u_InputTexture[pc.textureIndex], localPx, col);
        return;
    }

    for (uint i = 0u; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];

        // Segment endpoints in world
        vec2 muzzle = proj.EndPos - proj.Dir * proj.RayLen;
        vec2 endPt  = proj.EndPos;



        if ((pc.mode & MODE_SMOKE_HIT) != 0u && pc.NumProjectiles > 0u)
        {
            // Use the first projectile as reference
            ProjectileGPU proj0 = data[0];
            ivec2 endPx = worldToLocalPx(proj0.EndPos);

            // Highlight the target pixel in CYAN so we know where we intend to hit
            if (all(equal(localPx, endPx)))
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(0,1,1,1));
            }

            // Only one invocation (the end pixel) calls the brush once
            if (all(equal(localPx, endPx)))
            {
                // Force: ignore Z, treat non-health pixels as solid for this smoke test
                bool forceSol = true;
                bool igZ      = true;

                // Very loud marker ring around the end pixel so we know brush ran
                for (int oy = -2; oy <= 2; ++oy)
                for (int ox = -2; ox <= 2; ++ox)
                {
                    if (abs(ox) + abs(oy) == 2)
                    {
                        ivec2 q = endPx + ivec2(ox, oy);
                        if (q.x >= 0 && q.y >= 0 && q.x < imgSize.x && q.y < imgSize.y)
                        {
                            imageStore(u_InputTexture[pc.textureIndex], q, vec4(1,0,1,1)); // magenta ring
                        }
                    }
                }

                // Call your existing brush
                applyDamageBrush(proj0, endPx, /*zRayAtCenter*/ 0.0, forceSol, igZ);
            }

            // In smoke mode we’re done — don’t run the normal collision pipeline
            return;
        }



        // Visualization of start, end, and trail
        if (viz)
        {
            vec2 d0 = pixelCenterW - muzzle;
            if (dot(d0, d0) <= (markerR_W * markerR_W))
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(0, 0, 1, 1)); // blue start
            }

            vec2 d1 = pixelCenterW - endPt;
            if (dot(d1, d1) <= (markerR_W * markerR_W))
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(1, 1, 1, 1)); // white end
            }

            float dLineDbg = distPointToSegment(pixelCenterW, muzzle, endPt);
            if (dLineDbg <= trailHalf_W)
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(1, 0, 1, 1)); // magenta trail
            }
        }

        // Traveling fraction based on current projectile position
        float tTravel = hitscan ? 1.0
                                : clamp(dot(proj.Position - muzzle, proj.Dir) / max(proj.RayLen, 1e-6), 0.0, 1.0);

        // Param of this pixel along the ray
        float tPixel = clamp(dot(pixelCenterW - muzzle, proj.Dir) / max(proj.RayLen, 1e-6), 0.0, 1.0);

        // XY overlap: distance to segment <= projectile radius + half pixel
        float distSeg = distPointToSegment(pixelCenterW, muzzle, endPt);
        float radiusW = (PROJ_RADIUS_IS_WORLD == 1) ? proj.Radius : (proj.Radius * pc.PixelSize);
        bool  hitXY   = (distSeg <= (radiusW + halfPixW));
        if (!hitXY)
        {
            continue;
        }

        // Front window gating: only near the current front
        float leadSlackT = (LEAD_SLACK_PX * pc.PixelSize) / max(proj.RayLen, 1e-6);
        float backSlackT = (BACK_SLACK_PX * pc.PixelSize) / max(proj.RayLen, 1e-6);
        float armT       = (ARM_PX        * pc.PixelSize) / max(proj.RayLen, 1e-6);

        if (tTravel < armT)
        {
            if (why)
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(1.0, 0.5, 0.0, 1.0)); // orange: not armed yet
            }
            continue;
        }
        if (tPixel < tTravel - backSlackT || tPixel > tTravel + leadSlackT)
        {
            // Not near the front
            continue;
        }

        // Z at this pixel: ramp from a fixed start Z toward mouse height
        const float Z_FIXED = 0.5;
        float zRay = mix(Z_FIXED, proj.Z1, tPixel);

        // Texture height at this pixel
        float hW = float(props.g) * pc.PixelSize;
        if (hW < MIN_SOLID_Z)
        {
            hW = 0.0;
        }

        // Texture-solid and Z pass
        bool textureSolid = (props.r > 0u) || forceSol;
        // Must be an *alive* texel to be hit/destructible
        if (props.r == 0u && !forceSol)
        {
            if (why) { imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(0.0, 1.0, 1.0, 1.0)); } // cyan: dead
            continue;
        }

        // Z gate (only if alive)
        if (!igZ && (zRay > hW + EPS_Z))
        {
            if (why) { imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(1.0, 1.0, 0.0, 1.0)); } // yellow: above surface
            continue;
        }

        // Depth-ordered claim: closest along the ray wins.
        // Using inverted 16-bit key so initial 0 works with atomicMax.
        uint key16  = uint(tPixel * 65535.0 + 0.5);
        uint invKey = 65535u - key16;
        uint prev   = atomicMax(results[i].hitProjectileID_Low, invKey);
        uint cur    = atomicAdd(results[i].hitProjectileID_Low, 0u);
        if (invKey != cur)
        {
            if (why && !igClaim)
            {
                imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(0.5, 0.5, 0.5, 1.0)); // gray: lost to nearer
            }
            continue;
        }

        // Optional one-shot tag
        if (!igClaim)
        {
            uint tag = hashTag(proj.ID_Low, proj.ID_High);
            uint old = atomicCompSwap(results[i].collisionDetected, 0u, tag);
            if (old != 0u && old != tag)
            {
                if (why)
                {
                    imageStore(u_InputTexture[pc.textureIndex], localPx, vec4(0.5, 0.5, 0.5, 1.0));
                }
                continue;
            }
        }

        // Apply effect
        // ---- Apply effect with brush sized by proj.DestructionRadius (pixels)
        applyDamageBrush(proj, localPx, zRay, forceSol, igZ);

        if (viz && (props.r == 0u) && !forceSol)
        {
            int rpx = COLLISION_BRUSH_PX, r2 = rpx * rpx;
            for (int oy = -rpx; oy <= rpx; ++oy)
            for (int ox = -rpx; ox <= rpx; ++ox) 
            {
                if (ox*ox + oy*oy > r2) continue;
                ivec2 q = localPx + ivec2(ox, oy);
                if (q.x >= 0 && q.y >= 0 && q.x < imgSize.x && q.y < imgSize.y) 
                {
                    imageStore(u_InputTexture[pc.textureIndex], q, vec4(0.45, 0.3, 0.1, 1.0));
                }
            }
        }

        // Debug collision marker (green)
        if (viz)
        {
            int rpx = COLLISION_BRUSH_PX, r2 = rpx * rpx;
            for (int oy = -rpx; oy <= rpx; ++oy)
            for (int ox = -rpx; ox <= rpx; ++ox)
            {
                if (ox*ox + oy*oy > r2) continue;
                ivec2 q = localPx + ivec2(ox, oy);
                if (q.x >= 0 && q.y >= 0 && q.x < imgSize.x && q.y < imgSize.y)
                {
                    imageStore(u_InputTexture[pc.textureIndex], q, vec4(0, 1, 0, 1));
                }
            }
        }

        appendHit(proj, pixelCenterW, props.r);
        break;
    }
}
