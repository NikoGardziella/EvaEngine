#type compute
#version 450

#define MAX_TEXTURES 32
#define MAX_COLLISION_ENTITIES 64

layout(local_size_x = 16, local_size_y = 16) in;

// Texture bindings
layout(set = 0, binding = 0, rgba8) uniform image2D u_InputTexture[MAX_TEXTURES];
layout(set = 0, binding = 1, r8ui) uniform uimage2D u_HealthImage[MAX_TEXTURES];

// Collision result per projectile
struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _padding0;
    vec2 CollisionPosition;
    uint _padding1;
    uint _padding2;
};

// Projectile data sent from CPU
struct ProjectileGPU {
    vec2 Position;    // 8 bytes
    float Radius;     // 4 bytes
    uint Type;        // 4 bytes
    uint ID_Low;      // 4 bytes
    uint ID_High;     // 4 bytes
    vec2 Size;        // 8 bytes (only for Type 2)
    float Rotation;   // 4 bytes (only for Type 2)
    float _padding0;  // 4 bytes (align to 40)
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer {
    uint collisionCount;
    uint _padding0;
    uint _padding1;
    uint _padding2;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles {
    ProjectileGPU data[];
};


layout(push_constant) uniform PushConstants {
    vec2 TextureOrigin;
    float PixelSize;
    uint TextureIndex;
    uint NumProjectiles;
    uint mode; // 0 = Detect, 1 = Destroy
} pc;

// Helper: rotated box check
bool PointInRotatedBox(vec2 point, vec2 boxCenter, vec2 halfSize, float rotation)
{
    vec2 local = point - boxCenter;
    float cosR = cos(rotation);
    float sinR = sin(rotation);
    vec2 rotated = vec2(
        cosR * local.x + sinR * local.y,
       -sinR * local.x + cosR * local.y
    );
    return abs(rotated.x) <= halfSize.x && abs(rotated.y) <= halfSize.y;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    // Early out of bounds
    ivec2 texSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (pixelCoord.x >= texSize.x || pixelCoord.y >= texSize.y)
        return;

    vec4 pixel = imageLoad(u_InputTexture[pc.TextureIndex], pixelCoord);
    if (pixel.a == 0.0)
        return;

    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];
        bool collided = false;
       

        if (proj.Type == 0 || proj.Type == 1)
        {
            float dist = distance(worldPos, proj.Position);
            if (dist < proj.Radius)
            {
                collided = true;
            }
        }
        else if (proj.Type == 2)
        {
            if (PointInRotatedBox(worldPos, proj.Position, proj.Size * 0.5, proj.Rotation))
                collided = true;
        }

        if (collided)
        {
            uvec4 healthPixel = imageLoad(u_HealthImage[pc.TextureIndex], pixelCoord);
            uint health = healthPixel.r;
            if (health > 0) 
            {
                if(proj.Type == 0 || proj.Type == 2)
                    health -= 1;

                imageStore(u_HealthImage[pc.TextureIndex], pixelCoord, uvec4(health, 0, 0, 0));
                if (health == 0)
                {
                    imageStore(u_InputTexture[pc.TextureIndex], pixelCoord, vec4(0.0));
                }

                uint collisionIndex = atomicAdd(collisionCount, 1);
                if (collisionIndex < MAX_COLLISION_ENTITIES)
                {
                    results[collisionIndex].collisionDetected = 1;
                    results[collisionIndex].hitProjectileID_Low = proj.ID_Low;
                    results[collisionIndex].hitProjectileID_High = proj.ID_High;
                    results[collisionIndex].CollisionPosition = worldPos;
                }
            }

        }

    }
}
