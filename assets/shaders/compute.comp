#type compute
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform image2D u_InputTexture[32];
layout(binding = 1, rgba8) uniform image2D u_OutputTexture[32];

layout(binding = 2) buffer ResultBuffer {
    uint collisionDetected;
};

layout(std430, binding = 3) readonly buffer Projectiles
{
    vec4 data[]; // xy = position, z = radius
};

layout(push_constant) uniform PushConstants {
    vec2 PlayerPos;
    float Radius;
    float pad0;

    vec2 TextureOrigin;
    float PixelSize;
    uint TextureIndex;
    uint NumProjectiles;
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    // Bounds check
    ivec2 textureSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (pixelCoord.x >= textureSize.x || pixelCoord.y >= textureSize.y)
        return;

    // Load pixel from input
    vec4 pixel = imageLoad(u_InputTexture[pc.TextureIndex], pixelCoord);

    // Convert to world position
    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    // Check against all projectiles
    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        vec2 projectilePos = data[i].xy;
        float radius = data[i].z;

        float dist = distance(worldPos, projectilePos);
        if (dist < radius)
        {
            imageStore(u_OutputTexture[pc.TextureIndex], pixelCoord, vec4(0, 0, 0, 0));
            atomicOr(collisionDetected, 1);
            break;
        }
    }
}
