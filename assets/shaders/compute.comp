#type compute
#version 450
#extension GL_EXT_nonuniform_qualifier : require
#include "ComputeUtils.glsl"

// ---------- config ----------
#define MAX_TEXTURES            32
#define MAX_COLLISION_ENTITIES  32
#define SUBTILES_PER_TILE       3
#define FLAG_GLOW_TERRAIN       1

// BlockedTileMask bits
const uint MASK_ALIVE       = 1u;
const uint MASK_DESTROYED   = 2u;
const uint MASK_DYNFOOT_HIT = 4u;

// Categories (must match CPU)
const uint CAT_Undefined = 0u;
const uint CAT_Default   = 1u;
const uint CAT_Buildings = 2u;
const uint CAT_Terrain   = 3u;
const uint CAT_Roofs     = 4u;
const uint CAT_Vehicles  = 5u;
const uint CAT_Dynamic   = 6u;

// FX flag in props.a
const uint FX_ARMED = 1u;

layout(local_size_x = 16, local_size_y = 16) in;

// Bindless images (tile-per-descriptor)
layout(set=0, binding=0, rgba8)   uniform  image2D  uColor[];
layout(set=0, binding=1, rgba8ui) uniform uimage2D uProps[];

// SSBOs
struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _pad0;
    vec2 CollisionPosition;
    uint HealthAfter;
    uint _pad1;
};

struct ProjectileGPU {
    vec2  Position;
    float ColliderRadius; 
    uint  Type;
    uint  ID_Low;
    uint  ID_High;
    vec2  Size;
    float Rotation;
    uint  Damage;
    uint  DestructionRadius;
    uint  _pad0;
    vec2  EndPos;
    vec2  Dir;              // arbitrary length
    float RayLen;           // length from muzzle to EndPos along Dir
    float Z1;               // height at EndPos (rows or world; see below)
};

layout(std430, set=0, binding=2) buffer ResultBuffer {
    uint collisionCount;
    uint _padA;
    uint _padB;
    uint _padC;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set=0, binding=3) readonly buffer Projectiles { ProjectileGPU data[]; };

// NOTE: This buffer is assumed to be sized per tile: SUBTILES_PER_TILE^2 entries per tile dispatch.
layout(std430, set=0, binding=4) buffer BlockedTileMask { uint blockedMask[]; };
layout(set=0, binding=5, rgba8) uniform image2D uFX[];

// Push constants
layout(push_constant) uniform PC {
    vec2  TextureOriginWorld;  // world origin for texel (0,0) of THIS tile
    float PixelSizeWorld;      // world units per pixel
    uint  TextureIndex;        // bindless slot for THIS tile
    uint  NumProjectiles;
    uint  TileSizePixels;      // tile width/height in pixels (square assumed)
} pc;

// ---------- helpers ----------
uvec4 loadHT(uint slot, ivec2 px)            { return imageLoad(uProps[nonuniformEXT(slot)], px); }
void  storeHT(uint slot, ivec2 px, uvec4 ht) { imageStore(uProps[nonuniformEXT(slot)], px, ht); }
void  clearColor(uint slot, ivec2 px)        { imageStore(uColor[nonuniformEXT(slot)], px, vec4(0.0)); }

bool hasHealth(uvec4 ht) { return (ht.r > 0u); }
uint GetCategory(uvec4 props) { return (props.a >> 4u) & 0xFu; }
bool IsDynamic(uvec4 props)   { return GetCategory(props) == CAT_Dynamic; }
bool IsFootBand(uvec4 props)  { const uint HeightThresholdPx = 20u; return props.g <= HeightThresholdPx; }

uint baseEvents() { return pc.NumProjectiles; }
#define CLAIM(i)  results[(i)]                 // 0 .. NumProjectiles-1
#define EVENT(i)  results[baseEvents() + (i)]

uint packKey(float tNorm) 
{
    float tf = clamp(tNorm, 0.0, 1.0);
    uint  dist = uint(floor(tf * 16777215.0 + 0.5)); // 24 bits
    return (dist << 8) | (pc.TextureIndex & 0xFFu);  // low 8 bits = tile tie-breaker
}

// Try to become the winner for projectile i at param tHit.
// If we improved the key, also publish winner tile + hit info into the CLAIM slot.
bool updateClaimIfBetter(uint i, float tHit, vec2 hitW, ivec2 hitPx, const ProjectileGPU proj, uint healthAfter)
{
    uint k   = packKey(tHit);
    uint old = atomicMin(CLAIM(i).collisionDetected, k);
    if (k < old) {
        // we are the new best — publish winner info into the claim slot
        CLAIM(i).hitProjectileID_Low  = proj.ID_Low;
        CLAIM(i).hitProjectileID_High = proj.ID_High;
        CLAIM(i).CollisionPosition    = hitW;
        CLAIM(i).HealthAfter          = healthAfter;
        // stash winner tile + pixel in padding
        CLAIM(i)._pad0 = pc.TextureIndex;      // winner tile
        CLAIM(i)._pad1 = (uint(hitPx.y) << 16) | uint(hitPx.x); // pack px
        memoryBarrierBuffer();                 // make publication visible
        return true; // “currently best”
    }
    return false; // not better than current best
}



vec2 pixelCenterWorld(ivec2 lp) {
    return pc.TextureOriginWorld + (vec2(lp) + vec2(0.5)) * pc.PixelSizeWorld;
}

void storeMaxColor(uint slot, ivec2 p, vec3 col)
{
    ivec2 sz = imageSize(uColor[nonuniformEXT(slot)]);
    if (uint(p.x) >= uint(sz.x) || uint(p.y) >= uint(sz.y)) return;

    vec4 cur  = imageLoad(uColor[nonuniformEXT(slot)], p);
    vec3 rgb  = max(cur.rgb, col);     // emulate "max" blend for visibility
    imageStore(uColor[nonuniformEXT(slot)], p, vec4(rgb, 1.0));
}

// Cross marker of half-size `half` (e.g. 2 => 5px tall/wide)
void markHitCross(uint slot, ivec2 center, int Half, vec3 col)
{
    for (int dy = -Half; dy <= Half; ++dy) storeMaxColor(slot, center + ivec2(0, dy), col);
    for (int dx = -Half; dx <= Half; ++dx) storeMaxColor(slot, center + ivec2(dx, 0), col);
}

// Filled disk marker of radius `r` (e.g. 2 or 3)
void markHitDisk(uint slot, ivec2 center, int r, vec3 col)
{
    int r2 = r * r;
    for (int oy = -r; oy <= r; ++oy)
    for (int ox = -r; ox <= r; ++ox)
    {
        if (ox*ox + oy*oy > r2) continue;
        storeMaxColor(slot, center + ivec2(ox, oy), col);
    }
}



// Per-tile blocked mask: SUBTILES_PER_TILE × SUBTILES_PER_TILE entries (row-major)
void writeBlockedMaskIfNeeded(ivec2 lp, uint bits)
{
    const int spt = SUBTILES_PER_TILE;
    const int pxPerSub = max(1, int(pc.TileSizePixels) / spt);
    ivec2 subtile = clamp(lp / pxPerSub, ivec2(0), ivec2(spt-1));
    uint idx = uint(subtile.y * spt + subtile.x);
    atomicOr(blockedMask[idx], bits);
}

// Results / claim
uint appendBase() { return pc.NumProjectiles; }

uint hashProjTag(uint lo, uint hi) {
    uint h = 0x9E3779B9u ^ lo;
    h ^= hi + 0x85EBCA6Bu + (h << 6) + (h >> 2);
    h *= 0xC2B2AE35u;
    h ^= (h >> 16);
    return (h | 1u);
}

bool claimCollisionOnce(uint i, uint tag)
{
    if (i >= pc.NumProjectiles || i >= MAX_COLLISION_ENTITIES) return false;
    // Succeed only if 0 -> tag
    uint old = atomicCompSwap(results[i].collisionDetected, 0u, tag);
    return (old == 0u);
}

bool writeCollisionEvent(uint producerSlot, const ProjectileGPU proj,
                         vec2 worldPos, uint healthAfter)
{
    uint idx = atomicAdd(collisionCount, 1u);
    if (idx >= MAX_COLLISION_ENTITIES) return false;

    results[idx].collisionDetected    = 1u;
    results[idx].hitProjectileID_Low  = proj.ID_Low;
    results[idx].hitProjectileID_High = proj.ID_High;
    results[idx].CollisionPosition    = worldPos;
    results[idx].HealthAfter          = healthAfter;
    return true;
}

// FX/damage helpers
void rearmGlow_fx(bool fx, uint slot, ivec2 px, inout uvec4 ht, uint seed)
{
    if (!fx) return;
    uint s = min(seed, 255u);
    if (ht.b < s) ht.b = s;
    ht.a |= FX_ARMED;
    storeHT(slot, px, ht);
}
void destroyPixel_fx(bool fx, uint slot, ivec2 px, inout uvec4 ht)
{
    clearColor(slot, px);
    ht.r = 0u;
    if (fx) {
        uint s = min(20u, 255u);
        if (ht.b < s) ht.b = s;
        ht.a |= FX_ARMED;
    }
    storeHT(slot, px, ht);

    // masks (tile-local)
    writeBlockedMaskIfNeeded(px, MASK_DESTROYED);

    uvec4 propsNow = imageLoad(uProps[nonuniformEXT(slot)], px);
    if (IsDynamic(propsNow) && IsFootBand(propsNow))
        writeBlockedMaskIfNeeded(px, MASK_DYNFOOT_HIT);
}
void applyDamage_fx(bool /*fx*/, uint slot, ivec2 px, inout uvec4 ht, uint damage)
{
    uint h = ht.r;
    if (damage >= h)
    {
        clearColor(slot, px);
        ht.r = 0u;
        storeHT(slot, px, ht);
        writeBlockedMaskIfNeeded(px, MASK_DESTROYED);

        uvec4 propsNow = imageLoad(uProps[nonuniformEXT(slot)], px);
        if (IsDynamic(propsNow) && IsFootBand(propsNow))
            writeBlockedMaskIfNeeded(px, MASK_DYNFOOT_HIT);
    }
    else
    {
        ht.r = h - damage;
        storeHT(slot, px, ht);
    }
}

// Falloff (mode 0)
uint  getFalloffMode() { return 0u; }
float falloffWeight(float t, uint mode)
{
    t = clamp(t, 0.0, 1.0);
    if (mode == 0u) return 1.0;
    if (mode == 1u) return 1.0 - t;
    if (mode == 2u) { float w = 1.0 - t; return w*w; }
    const float eps = 0.05;
    float x = max(t, eps);
    float w = (1.0 / (x*x)) / (1.0 / (eps*eps));
    return clamp(w, 0.0, 1.0);
}




// Explosion: tile-only (no neighbor writes)
void processExplosionDiskFalloff(const ProjectileGPU proj, bool fx, ivec2 centerPx, ivec2 curSize)
{

    int r = int(proj.DestructionRadius);
    if (r <= 0) return;

    uint  mode     = getFalloffMode();
    float twoPi    = 6.28318530718;
    int   rayCount = max(32, int(ceil(twoPi * float(r) * 1.0)));
    const int BRUSH = 2;

    for (int d = 0; d < rayCount; ++d)
    {
        float ang = (twoPi * (float(d) + 0.5)) / float(rayCount);
        vec2  dir = vec2(cos(ang), sin(ang));

        for (int s = 1; s <= r; ++s)
        {
            ivec2 p = ivec2(floor(vec2(centerPx) + dir * float(s) + 0.5));
            if (p.x < 0 || p.y < 0 || p.x >= curSize.x || p.y >= curSize.y) break;

            vec4  col = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], p);
            uvec4 ht  = loadHT(pc.TextureIndex, p);
            bool  hasHP   = hasHealth(ht);
            bool  empty   = (col.a <= 0.0) && !hasHP;
            bool  terrain = (col.a >  0.0) && !hasHP;

            if (empty) { rearmGlow_fx(fx, pc.TextureIndex, p, ht, 20u); continue; }
            if (terrain)
            {
                if ((FLAG_GLOW_TERRAIN) != 0u) { rearmGlow_fx(fx, pc.TextureIndex, p, ht, 20u); }
                break;
            }

            float t   = float(s) / float(r);
            float w   = falloffWeight(t, mode);
            uint  dmg = uint(floor(float(proj.Damage) * w + 0.5));
            if (dmg == 0u) break;

            if (dmg < ht.r)
            {
                applyDamage_fx(false, pc.TextureIndex, p, ht, dmg);
                break;
            }
            else
            {
                destroyPixel_fx(fx, pc.TextureIndex, p, ht);

                for (int oy = -BRUSH; oy <= BRUSH; ++oy)
                for (int ox = -BRUSH; ox <= BRUSH; ++ox)
                {
                    if (ox*ox + oy*oy > BRUSH*BRUSH) continue;
                    ivec2 q = p + ivec2(ox, oy);
                    if (q.x < 0 || q.y < 0 || q.x >= curSize.x || q.y >= curSize.y) continue;

                    vec4  bcol = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], q);
                    uvec4 bht  = loadHT(pc.TextureIndex, q);
                    bool  bHas = hasHealth(bht);
                    bool  bTer = (bcol.a > 0.0) && !bHas;

                    if (bTer) {
                        // leave terrain alone
                    }
                    else if (!bHas) {
                        rearmGlow_fx(fx, pc.TextureIndex, q, bht, 20u);
                    }
                    else {
                        uint bdmg = max(1u, dmg / 2u);
                        if (bdmg < bht.r) applyDamage_fx(false, pc.TextureIndex, q, bht, bdmg);
                        else              destroyPixel_fx(fx,   pc.TextureIndex, q, bht);
                    }
                }
            }
        }
    }
}


void doImpactAtPixel(const ProjectileGPU proj, ivec2 pHit, ivec2 curSize)
{
    const uint slot = pc.TextureIndex;
    bool fx = true; // always arm FX for visuals

    // direct hit
    uvec4 ht  = loadHT(slot, pHit);
    vec4  col = imageLoad(uColor[nonuniformEXT(slot)], pHit);
    bool  hasHP   = hasHealth(ht);
    bool  empty   = (col.a <= 0.0) && !hasHP;
    bool  terrain = (col.a >  0.0) && !hasHP;

    if (hasHP)
    {
        if (proj.Damage < ht.r)
            applyDamage_fx(false, slot, pHit, ht, proj.Damage);
        else
            destroyPixel_fx(fx,  slot, pHit, ht);
    }
    else
    {
        // no HP → just arm glow so the impact is visible
        rearmGlow_fx(fx, slot, pHit, ht, 20u);
    }

    // area effect (stays within this tile by design)
    processExplosionDiskFalloff(proj, fx, pHit, curSize);
}

// Ray utilities
void rayFromProj(in ProjectileGPU proj, out vec2 dir, out float L, out vec2 A)
{
    dir = proj.Dir;
    float len2 = dot(dir, dir);
    if (len2 > 1e-12) dir *= inversesqrt(len2); else dir = vec2(1.0, 0.0);
    L  = max(proj.RayLen, 1e-6);
    A  = proj.EndPos - dir * L;          // muzzle
}
float arrivalT(in ProjectileGPU proj, vec2 dir, float L, vec2 A)
{
    return clamp(dot(proj.Position - A, dir) / L, 0.0, 1.0);
}
bool worldToPixelInTile(vec2 W, out ivec2 px, ivec2 curSize)
{
    vec2 pxf = (W - pc.TextureOriginWorld) / pc.PixelSizeWorld;
    px = ivec2(floor(pxf));
    return (px.x >= 0 && px.y >= 0 && px.x < curSize.x && px.y < curSize.y);
}

// Segment vs tile AABB in world
bool segmentVsRect(vec2 A, vec2 dir, float L, vec2 rectMinW, vec2 rectMaxW,
                   out float tEnter, out float tExit)
{
    float t0 = 0.0, t1 = 1.0;
    // X
    {
        float d = dir.x, o = A.x, mn = rectMinW.x, mx = rectMaxW.x;
        if (abs(d) < 1e-8) { if (o < mn || o > mx) return false; }
        else {
            float inv = 1.0 / (L * d);
            float ta = (mn - o) * inv;
            float tb = (mx - o) * inv;
            float tmin = min(ta, tb), tmax = max(ta, tb);
            t0 = max(t0, tmin);
            t1 = min(t1, tmax);
            if (t1 < t0) return false;
        }
    }
    // Y
    {
        float d = dir.y, o = A.y, mn = rectMinW.y, mx = rectMaxW.y;
        if (abs(d) < 1e-8) { if (o < mn || o > mx) return false; }
        else {
            float inv = 1.0 / (L * d);
            float ta = (mn - o) * inv;
            float tb = (mx - o) * inv;
            float tmin = min(ta, tb), tmax = max(ta, tb);
            t0 = max(t0, tmin);
            t1 = min(t1, tmax);
            if (t1 < t0) return false;
        }
    }
    tEnter = t0; tExit = t1; return true;
}


bool projectileHitByType(const ProjectileGPU proj, ivec2 localPx)
{
    // pixel center in world
    vec2  P  = pc.TextureOriginWorld + (vec2(localPx) + vec2(0.5)) * pc.PixelSizeWorld;
    float H  = 0.5 * pc.PixelSizeWorld; // half cell in world

    float Rw = proj.ColliderRadius * pc.PixelSizeWorld;

    if (isProjectile(proj.Type))
    {
        // circle vs cell (no sqrt)
        vec2 q = abs(proj.Position - P) - vec2(H);
        vec2 m = max(q, 0.0);
        return dot(m, m) <= Rw * Rw;
    }
    else if (isVehicle(proj.Type))
    {
        // rotated AABB vs point
        float cs = cos(proj.Rotation), sn = sin(proj.Rotation);
        vec2  d  = P - proj.Position;
        vec2  q2 = vec2(cs*d.x + sn*d.y, -sn*d.x + cs*d.y);
        vec2  h  = proj.Size * 0.5;
        return (abs(q2.x) <= h.x) && (abs(q2.y) <= h.y);
    }
    return false;
}


// ---- DEBUG helpers (visual overlay) ----
const bool DEBUG = true;

void debugDot(ivec2 px, vec3 col)
{
    if (!DEBUG) { return; }
    vec4 c = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], px);
    // brighten towards the debug color without fully destroying art
    vec3 outc = max(c.rgb, col);
    imageStore(uColor[nonuniformEXT(pc.TextureIndex)], px, vec4(outc, 1.0));
}

void debugCross(ivec2 px, vec3 col)
{
    if (!DEBUG) { return; }
    for (int dy = -2; dy <= 2; ++dy)
    {
        ivec2 p = px + ivec2(0, dy);
        ivec2 sz = imageSize(uColor[nonuniformEXT(pc.TextureIndex)]);
        if (p.x >= 0 && p.y >= 0 && p.x < sz.x && p.y < sz.y) { debugDot(p, col); }
    }
    for (int dx = -2; dx <= 2; ++dx)
    {
        ivec2 p = px + ivec2(dx, 0);
        ivec2 sz = imageSize(uColor[nonuniformEXT(pc.TextureIndex)]);
        if (p.x >= 0 && p.y >= 0 && p.x < sz.x && p.y < sz.y) { debugDot(p, col); }
    }
}



void cellMinMax (ivec2 px, out vec2 cmin, out vec2 cmax)
{
    cmin = pc.TextureOriginWorld + vec2(px) * pc.PixelSizeWorld;
    cmax = cmin + vec2(pc.PixelSizeWorld);
}

bool claimOnce(uint projIndex)
{
    // CPU must zero results[i].collisionDetected for i < pc.NumProjectiles each frame.
    uint old = atomicCompSwap(results[projIndex].collisionDetected, 0u, pc.TextureIndex);
    return (old == 0u);
}

// Helper to test "empty"
bool isEmpty (ivec2 p)
{
    ivec2 curSize = imageSize(uColor[nonuniformEXT(pc.TextureIndex)]);

    if (p.x < 0 || p.y < 0 || p.x >= curSize.x || p.y >= curSize.y) return true;
    uvec4 hq = loadHT(pc.TextureIndex, p);
    vec4  cq = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], p);
    return (hq.r == 0u && cq.a == 0.0);
}

// Key packing ---------------------------------------------------------------

uint encodeT24(float t){ return uint(clamp(t,0.0,1.0)*16777215.0 + 0.5); }
float aimedBiasT(float L){ return clamp((0.25 * pc.PixelSizeWorld)/max(L,1e-6), 0.0, 0.02); }

// high 24 bits = t, next 7 bits = tile index (0..127), lowest bit = tier (0=aimed,1=overlap)
// (If you have >128 tile slots, widen the tile slice accordingly.)
uint makeKey(float t, bool aimed, float L)
{
    float tb = aimed ? max(0.0, t - aimedBiasT(L)) : t;
    uint  tq = encodeT24(tb);
    uint  tier = aimed ? 0u : 1u;
    uint  tileSlice = (pc.TextureIndex & 0x7Fu) << 1; // 7 bits
    return (tq << 8) | tileSlice | tier;
}

// Winner metadata publish ---------------------------------------------------
uint packPx16(ivec2 px) { return (uint(px.x) & 0xFFFFu) | (uint(px.y) << 16); }

// Write the winner info into the claim slot (results[i])
void writeClaimMeta(uint i, uint slot, ivec2 px, vec2 posW, uint healthAfter)
 {
    ProjectileGPU proj = data[i]; // fix

    atomicAdd(collisionCount, 1u);
    
    results[i]._pad0             = slot;                 // winner tile slot
    results[i]._pad1             = packPx16(px);         // winner pixel (x|y)
    results[i].CollisionPosition = posW;                 // where the hit is
    results[i].HealthAfter       = healthAfter;          // optional payload
    results[i].hitProjectileID_Low  = proj.ID_Low;
    results[i].hitProjectileID_High = proj.ID_High;
}

// Atomic “min” claim: CPU must prefill results[i].collisionDetected = 0xFFFFFFFFu
void tryClaimMin(uint i, uint key, uint slot, ivec2 px, vec2 posW, uint healthAfter) 
{
    uint old = atomicMin(results[i].collisionDetected, key);
    if (key < old)
    {
        writeClaimMeta(i, slot, px, posW, healthAfter);
        memoryBarrierBuffer(); // ensure metadata visible to later passes
    }
}


void main()
{
    ivec2 curSize = imageSize(uColor[nonuniformEXT(pc.TextureIndex)]);
    ivec2 localPx = ivec2(gl_GlobalInvocationID.xy);
    if (uint(localPx.x) >= uint(curSize.x) || uint(localPx.y) >= uint(curSize.y)) return;

    vec2  worldPos    = pixelCenterWorld(localPx);
    uvec4 centerHT    = loadHT(pc.TextureIndex, localPx);
    bool  centerHasHP = (centerHT.r > 0u);

    vec2 rectMinW = pc.TextureOriginWorld;
    vec2 rectMaxW = rectMinW + vec2(curSize) * pc.PixelSizeWorld;

    const float Z_TOL   = 0.5 * pc.PixelSizeWorld;
    const float Z_FIXED = 0.5;


    for (uint i = 0u; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];

        // Parametric ray A..A+dir*L  (normalize dir; keep L separate)
        vec2  dir  = proj.Dir;
        float len2 = dot(dir, dir);
        if (len2 > 1e-12) dir *= inversesqrt(len2); else dir = vec2(1.0, 0.0);
        float L  = max(proj.RayLen, 1e-6);
        vec2  A  = proj.EndPos - dir * L;

        // Is EndPos in THIS tile?
        bool endInside =
            (proj.EndPos.x >= rectMinW.x && proj.EndPos.x < rectMaxW.x &&
             proj.EndPos.y >= rectMinW.y && proj.EndPos.y < rectMaxW.y);

        bool  endQualifies = false;
        ivec2 pEnd = ivec2(-1);
        bool headInside =
            (proj.Position.x >= rectMinW.x && proj.Position.x < rectMaxW.x &&
            proj.Position.y >= rectMinW.y && proj.Position.y < rectMaxW.y);
        if (!headInside) continue;

        if (endInside)
        {
            // Aimed texel (tiny bias to avoid double-ownership on borders)
            const float EPS = 1e-5;
            vec2  uvEnd = (proj.EndPos - pc.TextureOriginWorld) / pc.PixelSizeWorld;
            pEnd = clamp(ivec2(floor(uvEnd - vec2(EPS))), ivec2(0), curSize - ivec2(1));

            uvec4 endHT  = loadHT(pc.TextureIndex, pEnd);
            vec4  endCol = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], pEnd);
            endQualifies = (endHT.r > 0u) || (endCol.a > 0.0);
        }

        // -------- AIMED-TEXEL PATH --------
        if (endInside && endQualifies)
        {
                    
            if (!all(equal(localPx, pEnd))) continue;

            float tNow    = clamp(dot(proj.Position - A, dir) / L, 0.0, 1.0);
            vec2  Pcenter = pixelCenterWorld(pEnd);
            float tTarget = clamp(dot(Pcenter - A, dir) / L, 0.0, 1.0);

            float arriveTolW = max(proj.ColliderRadius * pc.PixelSizeWorld, 1.25 * pc.PixelSizeWorld);
            float arriveTolT = clamp(arriveTolW / L, 0.001, 0.5);
            if (tNow + 1e-6 < tTarget - arriveTolT) continue;

            //  replace claimOnce+writeCollisionEvent with the min-key claim:
            uint key = makeKey(tTarget, /*aimed*/true, L);
            tryClaimMin(i, key, pc.TextureIndex, pEnd, Pcenter, centerHT.r);

            // optional visual in the collision pass
            // debugCross(pEnd, vec3(0.9, 0.1, 0.1));


            break;
        }
        else
        {
            // Only the tile that contains the projectile head may try
            if (!(proj.Position.x >= rectMinW.x && proj.Position.x < rectMaxW.x &&
                proj.Position.y >= rectMinW.y && proj.Position.y < rectMaxW.y))
                continue;

            //  skip overlap if EndPos is too close to current position (< 128 px)
            {
                vec2  d        = proj.EndPos - proj.Position;
                float pxW      = pc.PixelSizeWorld;
                float thrPx    = 128.0;
                float thr2W    = (thrPx * pxW) * (thrPx * pxW); // world^2
                float dist2W   = dot(d, d);
                if (dist2W < thr2W) continue;
            }

            if(centerHT.g < 50)
            {
                continue;
            }


            // Ray vs THIS pixel’s cell AABB
            vec2 cmin = pc.TextureOriginWorld + vec2(localPx) * pc.PixelSizeWorld;
            vec2 cmax = cmin + vec2(pc.PixelSizeWorld);

            float tEnter, tExit;
            if (!segmentVsRect(A, dir, L, cmin, cmax, tEnter, tExit)) continue;

            // Don’t look past the aim point
            float tAim = clamp(dot(proj.EndPos - A, dir) / L, 0.0, 1.0);
            float t0   = max(0.0, tEnter);
            float t1   = min(tAim, tExit);
            if (t1 <= t0) continue;

            // Arrival gate
            float tNow = clamp(dot(proj.Position - A, dir) / L, 0.0, 1.0);
            float arriveTolW = max(proj.ColliderRadius * pc.PixelSizeWorld, 1.0 * pc.PixelSizeWorld);
            float arriveTolT = clamp(arriveTolW / L, 0.0005, 0.5);
            if (tNow + 1e-6 < t0 - arriveTolT) continue;

            // Z gate at pixel center
            float tPixel = clamp(dot(worldPos - A, dir) / L, 0.0, 1.0);
            float zRay   = mix(Z_FIXED, proj.Z1, tPixel);
            float hW     = (centerHT.g > 0u) ? max(float(centerHT.g) * pc.PixelSizeWorld, 0.0)
                                            : 0.5 * float(curSize.y) * pc.PixelSizeWorld;
            if (zRay > hW + Z_TOL) continue;

            // Require material at THIS pixel
            vec4 centerCol    = imageLoad(uColor[nonuniformEXT(pc.TextureIndex)], localPx);
            bool isTerrainArt = (centerCol.a > 0.0) && !centerHasHP;
            if (!(centerHasHP)) continue;

            // Earliest candidate wins globally (compare on entry param t0)
            uint key = makeKey(t0, /*aimed*/false, L);
            tryClaimMin(i, key, pc.TextureIndex, localPx, worldPos, centerHT.r);

            
        }

    }
}
