#type compute
#version 450

// ---------- config ----------
#define MAX_TEXTURES            32
#define MAX_COLLISION_ENTITIES  64
#define CHUNK_SIZE              32
#define SUBTILES_PER_TILE       4
#define GRID_WIDTH              3
#define GRID_HEIGHT             3
#define ACTIVE_SLOTS            (GRID_WIDTH * GRID_HEIGHT)  // 9

layout(local_size_x = 16, local_size_y = 16) in;

// ---------- resources ----------
layout(set = 0, binding = 0, rgba8)   uniform  image2D  u_InputTexture[MAX_TEXTURES]; // color (UNORM)
layout(set = 0, binding = 1, rgba8ui) uniform uimage2D u_HealthImage[MAX_TEXTURES];   // r=health, g=timer

struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _pad0;
    vec2 CollisionPosition;
    uint HealthAfter;
    uint _pad1;
};

struct ProjectileGPU {
    vec2  Position;           // world units
    float Radius;             // world units (circle) — used by Type 0/1
    uint  Type;               // 0/1=circle, 2=box
    uint  ID_Low;
    uint  ID_High;
    vec2  Size;               // world units (box)
    float Rotation;           // radians
    uint  Damage;             // health units
    uint  DestructionRadius;  // pixels (radius for clearing)
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer {
    uint collisionCount;
    uint _padA;
    uint _padB;
    uint _padC;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles { ProjectileGPU data[]; };
layout(std430, set = 0, binding = 4) buffer BlockedTileMask      { uint blockedMask[]; };

// Push constants
layout(push_constant) uniform PushConstants {
    vec2  TextureOriginWorld;  // top-left of THIS chunk in world units
    float PixelSizeWorld;      // world units per pixel
    uint  TextureIndex;        // 0..8 inside the 3x3

    uint  NumProjectiles;
    uint  Mode;                // (unused here)
    uint  ChunkSizePixels;     // pixels per chunk (e.g. 512)
    uint  TileSizePixels;      // pixels per tile  (e.g. 128)

    ivec2 MinChunkCoords;      // top-left chunk coords of the active 3x3 window
} pc;

// ---------- helpers ----------
bool pointInRotatedBox(vec2 p, vec2 c, vec2 halfSize, float rot)
{
    vec2 d = p - c;
    float cs = cos(rot), sn = sin(rot);
    vec2 q = vec2(cs*d.x + sn*d.y, -sn*d.x + cs*d.y);
    return (abs(q.x) <= halfSize.x) && (abs(q.y) <= halfSize.y);
}

// Wrap a local pixel (relative to current chunk) into neighbor slot by index
void mapToNeighborSlot(ivec2 localPx, ivec2 curTexSize,
                       out uint writeSlot, out ivec2 writePx)
{
    int gridW = GRID_WIDTH, gridH = GRID_HEIGHT;
    int cx = int(pc.TextureIndex % uint(gridW));
    int cy = int(pc.TextureIndex / uint(gridW));

    int sx = 0, sy = 0;
    ivec2 p = localPx;

    if      (p.x < 0)              { sx = -1; p.x += curTexSize.x; }
    else if (p.x >= curTexSize.x)  { sx = +1; p.x -= curTexSize.x; }

    if      (p.y < 0)              { sy = -1; p.y += curTexSize.y; }
    else if (p.y >= curTexSize.y)  { sy = +1; p.y -= curTexSize.y; }

    int nx = cx + sx;
    int ny = cy + sy;

    if (nx < 0 || nx >= gridW || ny < 0 || ny >= gridH) {
        writeSlot = 0xffffffffu;
        writePx   = ivec2(0);
        return;
    }

    writeSlot = uint(ny * gridW + nx);
    writePx   = p;
}

// ---------- main ----------
void main()
{
    if (pc.TextureIndex >= ACTIVE_SLOTS) return;

    ivec2 localPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 curSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (localPx.x >= curSize.x || localPx.y >= curSize.y) return;

    // No early-return on alpha: we still need collisions + neighbor spill
    vec2 worldPos = pc.TextureOriginWorld + vec2(localPx) * pc.PixelSizeWorld;

    // Health/timer for this pixel
    uvec4 ht = imageLoad(u_HealthImage[pc.TextureIndex], localPx);
    uint  health = ht.r;

    if (health > 0u)
    {
        // Tile coordinate INSIDE THIS CHUNK (integer divide)
        int tileSize = int(pc.TileSizePixels);
        ivec2 tileInChunk = localPx / tileSize;                          

        // Pixel coordinate INSIDE THE TILE
        ivec2 pxInTile    = localPx - tileInChunk * tileSize;            

        // Subtile inside this tile
        int subDiv = tileSize / SUBTILES_PER_TILE;                       
        ivec2 subtile = ivec2(pxInTile.x / subDiv, pxInTile.y / subDiv);  

        // Chunk position in the 3×3 window from TextureIndex (row-major)
        int gridW = GRID_WIDTH;
        int gridH = GRID_HEIGHT;
        int cx = int(pc.TextureIndex % uint(gridW));
        int cy = int(pc.TextureIndex / uint(gridW));

        // GLOBAL tile coordinates within the whole window
        // (grid chunk coords * tiles-per-chunk) + tile-inside-chunk
        ivec2 windowTile = ivec2(cx * CHUNK_SIZE + tileInChunk.x,
                                 cy * CHUNK_SIZE + tileInChunk.y);

        // Flatten to the blockedMask index (row-major over subtiles)
        const int subtilesPerRow = GRID_WIDTH  * CHUNK_SIZE * SUBTILES_PER_TILE;
        const int subtilesRows   = GRID_HEIGHT * CHUNK_SIZE * SUBTILES_PER_TILE;

        int ix = windowTile.x * SUBTILES_PER_TILE + subtile.x;
        int iy = windowTile.y * SUBTILES_PER_TILE + subtile.y;

        if (ix >= 0 && iy >= 0 && ix < subtilesPerRow && iy < subtilesRows)
        {
            uint idx = uint(iy) * uint(subtilesPerRow) + uint(ix);
            atomicExchange(blockedMask[idx], 1u);
        }
    }


    // ----- collision / damage / effects -----
    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];

        bool hit = false;
        if (proj.Type == 0u || proj.Type == 1u)
        {
            hit = (distance(worldPos, proj.Position) < proj.Radius);
        }
        else if (proj.Type == 2u)
        {
            hit = pointInRotatedBox(worldPos, proj.Position, proj.Size * 0.5, proj.Rotation);
        }
        if (!hit) continue;

        // If this pixel is already empty, let a neighbor with health claim it
        if (health == 0u) continue;

        // Claim once (after health check)
        if (i >= MAX_COLLISION_ENTITIES) continue;
        if (atomicCompSwap(results[i].collisionDetected, 0u, 1u) != 0u) continue;

        // Current chunk size for neighbor mapping
        ivec2 curSize = imageSize(u_InputTexture[pc.TextureIndex]);

        // ----- center damage -----
        uvec4 centerHT   = imageLoad(u_HealthImage[pc.TextureIndex], localPx);
        uint  prevCenter = centerHT.r;
        uint  newCenter  = prevCenter;

        bool damagesTerrain = (proj.Type == 0u || proj.Type == 2u);
        if (damagesTerrain)
        {
            newCenter  = (proj.Damage >= newCenter) ? 0u : (newCenter - proj.Damage);
            centerHT.r = newCenter;

            // Start effects via sentinels:
            // 255 = destroyed flash, 254 = impact flash (only arm if not already running)
            if (newCenter == 0u)
            {
                centerHT.g = 255u;
                imageStore(u_InputTexture[pc.TextureIndex], localPx, vec4(0.0)); // clear only if dead
            }
            else
            {
                if (centerHT.g == 0u) centerHT.g = 254u;
            }

            imageStore(u_HealthImage[pc.TextureIndex], localPx, centerHT);

            // ----- radius damage (ALWAYS, even if center survives) -----
            int rpx = int(proj.DestructionRadius);

            for (int dy = -rpx; dy <= rpx; ++dy)
            for (int dx = -rpx; dx <= rpx; ++dx)
            {
                int d2 = dx*dx + dy*dy;
                if (d2 > rpx*rpx) continue;
                if (dx == 0 && dy == 0) continue; // center handled

                // Map to neighbor slot / coords
                uint  dstSlot;
                ivec2 dstPx;
                mapToNeighborSlot(localPx + ivec2(dx, dy), curSize, dstSlot, dstPx);
                if (dstSlot == 0xffffffffu || dstSlot >= ACTIVE_SLOTS) continue;

                ivec2 dstSize = imageSize(u_InputTexture[dstSlot]);
                if (dstPx.x < 0 || dstPx.y < 0 || dstPx.x >= dstSize.x || dstPx.y >= dstSize.y) continue;

                // Neighbor health
                uvec4 nht = imageLoad(u_HealthImage[dstSlot], dstPx);
                uint  h   = nht.r;

                if (h == 0u)
                {
                    // Already destroyed: keep clear and arm destroyed flash if idle
                    imageStore(u_InputTexture[dstSlot], dstPx, vec4(0.0));
                    if (nht.g == 0u) nht.g = 255u;
                    imageStore(u_HealthImage[dstSlot], dstPx, nht);
                    continue;
                }

                // Damage model — constant damage to all neighbors in radius
                uint neighborDamage = proj.Damage;

                // // Optional linear falloff:
                // float distNorm = sqrt(float(d2)) / float(rpx);     // 0..1
                // float scale    = clamp(1.0 - distNorm, 0.0, 1.0);
                // uint  neighborDamage = uint(max(1.0, floor(float(proj.Damage) * scale)));

                uint newH = (neighborDamage >= h) ? 0u : (h - neighborDamage);
                nht.r = newH;

                if (newH == 0u)
                {
                    imageStore(u_InputTexture[dstSlot], dstPx, vec4(0.0)); // clear only if dead
                    nht.g = 255u;                                          // destroyed flash
                }
                else
                {
                    if (nht.g == 0u) nht.g = 254u;                          // impact flash (first time)
                }

                imageStore(u_HealthImage[dstSlot], dstPx, nht);
            }
        }

        // Record result
        results[i].hitProjectileID_Low  = proj.ID_Low;
        results[i].hitProjectileID_High = proj.ID_High;
        results[i].CollisionPosition    = worldPos;
        results[i].HealthAfter          = damagesTerrain ? newCenter : prevCenter;
        atomicAdd(collisionCount, 1u);
        break;
    }




}
