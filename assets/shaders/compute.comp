#type compute
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform image2D u_InputTexture[32];
layout(binding = 1, rgba8) uniform image2D u_OutputTexture[32];

layout(binding = 2) buffer ResultBuffer {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _padding0;

    vec2 CollisionPosition;
    vec2 _padding1;
};

struct ProjectileGPU {
    vec2 Position;
    float Radius;
    uint Type;      // 0 = projectile, 1 = player
    uint ID_Low;
    uint ID_High;
};


layout(std140, set = 0, binding = 3) readonly buffer Projectiles
{
    ProjectileGPU data[];
};

layout(push_constant) uniform PushConstants {
    vec2 Remove1;
    float Remove;
    float pad0;

    vec2 TextureOrigin;
    float PixelSize;
    uint TextureIndex;
    uint NumProjectiles;
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    // Bounds check
    ivec2 textureSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (pixelCoord.x >= textureSize.x || pixelCoord.y >= textureSize.y)
        return;

    // Load pixel from input
    vec4 pixel = imageLoad(u_InputTexture[pc.TextureIndex], pixelCoord);
    if (pixel.a == 0.0)
    return;

    // Convert to world position
    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        vec2 projectilePos = data[i].Position;
        float radius = data[i].Radius;
        uint type = data[i].Type;

        float dist = distance(worldPos, projectilePos);
        if (dist < radius)
        {
            if (type == 0) // Only destroy pixels for actual projectiles
            {
                imageStore(u_OutputTexture[pc.TextureIndex], pixelCoord, vec4(0, 0, 0, 0));
            }

            if (atomicCompSwap(collisionDetected, 0u, 1u) == 0u)
            {
                CollisionPosition = worldPos;
                atomicExchange(hitProjectileID_Low, data[i].ID_Low);
                atomicExchange(hitProjectileID_High, data[i].ID_High);
            }
        }
    }
}
