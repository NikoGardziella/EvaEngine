#type compute
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// One input and one output texture per dispatch
layout(binding = 0, rgba8) uniform image2D u_InputTexture;
layout(binding = 1, rgba8) uniform image2D u_OutputTexture;

// Result buffer to store collision flag
layout(binding = 2) buffer ResultBuffer {
    uint collisionDetected;
};

// Push constants
layout(push_constant) uniform PushConstants {
    vec2 PlayerPos;       // Player position in world space
    float Radius;         // Radius of collision in world units

    vec2 TextureOrigin;   // World-space origin of this texture (bottom-left corner)
    float PixelSize;      // World size of one pixel
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    
    // Load pixel from input
    vec4 pixel = imageLoad(u_InputTexture, pixelCoord);

    // Convert to world-space position
    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    float dist = distance(worldPos, pc.PlayerPos);
    int intDistance = int(dist);

    if (dist < pc.Radius)
    {
        // Collision: clear pixel and set flag
        imageStore(u_OutputTexture, pixelCoord, vec4(0.0));
        atomicOr(collisionDetected, 1);
    }
    else
    {
        // No collision: preserve original
        atomicOr(collisionDetected, intDistance);
        imageStore(u_OutputTexture, pixelCoord, pixel);
    }
}
