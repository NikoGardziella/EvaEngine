#type compute
#version 450

// ---------- config ----------
#define MAX_TEXTURES            32
#define MAX_COLLISION_ENTITIES  64
#define CHUNK_SIZE              32          // tiles per chunk (not pixels)
#define SUBTILES_PER_TILE       4
#define GRID_WIDTH              3
#define GRID_HEIGHT             3
#define ACTIVE_SLOTS            (GRID_WIDTH * GRID_HEIGHT)  // 9

layout(local_size_x = 16, local_size_y = 16) in;

// ---------- resources ----------
layout(set = 0, binding = 0, rgba8)   uniform  image2D  u_InputTexture[ACTIVE_SLOTS]; // color (UNORM)
layout(set = 0, binding = 1, rgba8ui) uniform uimage2D u_HealthImage[ACTIVE_SLOTS];   // r=health, g=timer/sentinel

struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _pad0;
    vec2 CollisionPosition;
    uint HealthAfter;
    uint _pad1;
};

struct ProjectileGPU {
    vec2  Position;           // world units
    float Radius;             // world units (circle) for Type 0/1
    uint  Type;               // 0/1=circle, 2=box
    uint  ID_Low;
    uint  ID_High;
    vec2  Size;               // world units (box)
    float Rotation;           // radians
    uint  Damage;             // health units
    uint  DestructionRadius;  // pixels (radius for clearing)
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer {
    uint collisionCount;
    uint _padA;
    uint _padB;
    uint _padC;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles { ProjectileGPU data[]; };
layout(std430, set = 0, binding = 4) buffer BlockedTileMask      { uint blockedMask[]; };

// Push constants
layout(push_constant) uniform PushConstants {
    vec2  TextureOriginWorld;  // top-left of this chunk in world units
    float PixelSizeWorld;      // world units per pixel
    uint  TextureIndex;        // 0..8 inside the 3x3

    uint  NumProjectiles;
    uint  Mode;                // unused here
    uint  ChunkSizePixels;     // pixels per chunk (e.g. 512)
    uint  TileSizePixels;      // pixels per tile (e.g. 128)

    ivec2 MinChunkCoords;      // top-left chunk coords of the active 3x3 window
} pc;

// ---------- helpers ----------
bool pointInRotatedBox(vec2 p, vec2 c, vec2 halfSize, float rot)
{
    vec2 d = p - c;
    float cs = cos(rot), sn = sin(rot);
    vec2 q = vec2(cs*d.x + sn*d.y, -sn*d.x + cs*d.y);
    return (abs(q.x) <= halfSize.x) && (abs(q.y) <= halfSize.y);
}

void mapToNeighborSlot(ivec2 localPx, ivec2 curTexSize,
                       out uint writeSlot, out ivec2 writePx)
{
    int gridW = GRID_WIDTH, gridH = GRID_HEIGHT;
    int cx = int(pc.TextureIndex % uint(gridW));
    int cy = int(pc.TextureIndex / uint(gridW));

    int sx = 0, sy = 0;
    ivec2 p = localPx;

    if      (p.x < 0)             { sx = -1; p.x += curTexSize.x; }
    else if (p.x >= curTexSize.x) { sx = +1; p.x -= curTexSize.x; }

    if      (p.y < 0)             { sy = -1; p.y += curTexSize.y; }
    else if (p.y >= curTexSize.y) { sy = +1; p.y -= curTexSize.y; }

    int nx = cx + sx;
    int ny = cy + sy;

    if (nx < 0 || nx >= gridW || ny < 0 || ny >= gridH) {
        writeSlot = 0xffffffffu;
        writePx   = ivec2(0);
        return;
    }

    writeSlot = uint(ny * gridW + nx);
    writePx   = p;
}

// ---------- main ----------
void main()
{
    if (pc.TextureIndex >= ACTIVE_SLOTS) return;

    ivec2 localPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 curSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (localPx.x >= curSize.x || localPx.y >= curSize.y) return;

    vec2 worldPos = pc.TextureOriginWorld + vec2(localPx) * pc.PixelSizeWorld;

    // Read color and health
    vec4  base = imageLoad(u_InputTexture[pc.TextureIndex], localPx);
    uvec4 ht   = imageLoad(u_HealthImage[pc.TextureIndex], localPx);
    uint  health = ht.r;

    // Material classification
    bool solidColor      = (base.a > 0.0);
    bool destructible    = (health > 0u);                 // building, etc.
    bool immutableSolid  = solidColor && !destructible;   // terrain (alpha>0, health==0)
    bool emptySpace      = (!solidColor) && (health == 0u);

    // Blocked mask: any visible pixel blocks (destructible)
    if (solidColor && destructible)
    {
        int tileSize = int(pc.TileSizePixels);
        ivec2 tileInChunk = localPx / tileSize;
        ivec2 pxInTile    = localPx - tileInChunk * tileSize;
        int subDiv        = tileSize / SUBTILES_PER_TILE;
        ivec2 subtile     = ivec2(pxInTile.x / subDiv, pxInTile.y / subDiv);

        int gridW = GRID_WIDTH, gridH = GRID_HEIGHT;
        int cx = int(pc.TextureIndex % uint(gridW));
        int cy = int(pc.TextureIndex / uint(gridW));

        ivec2 windowTile = ivec2(cx * CHUNK_SIZE + tileInChunk.x,
                                 cy * CHUNK_SIZE + tileInChunk.y);

        const int subtilesPerRow = GRID_WIDTH  * CHUNK_SIZE * SUBTILES_PER_TILE;
        const int subtilesRows   = GRID_HEIGHT * CHUNK_SIZE * SUBTILES_PER_TILE;

        int ix = windowTile.x * SUBTILES_PER_TILE + subtile.x;
        int iy = windowTile.y * SUBTILES_PER_TILE + subtile.y;

        if (ix >= 0 && iy >= 0 && ix < subtilesPerRow && iy < subtilesRows)
        {
            uint idx = uint(iy) * uint(subtilesPerRow) + uint(ix);
            atomicExchange(blockedMask[idx], 1u);
        }
    }

        // ----- collision / damage / effects -----
        for (uint i = 0; i < pc.NumProjectiles; ++i)
        {
            ProjectileGPU proj = data[i];

            bool hit = false;
            if (proj.Type == 0u || proj.Type == 1u)
            {
                hit = (distance(worldPos, proj.Position) < proj.Radius);
            }
            else if (proj.Type == 2u)
            {
                hit = pointInRotatedBox(worldPos, proj.Position, proj.Size * 0.5, proj.Rotation);
            }
            if (!hit)
            {
                continue;
            }

            // Do not react on empty center or terrain center; let another pixel claim
            if (emptySpace || immutableSolid)
            {
                continue;
            }

            // From here: center is destructible
            if (i >= MAX_COLLISION_ENTITIES) continue;
            if (atomicCompSwap(results[i].collisionDetected, 0u, 1u) != 0u) continue;

            ivec2 curSizeNow = imageSize(u_InputTexture[pc.TextureIndex]);

            // ----- center damage (no effect if it survives) -----
            uvec4 centerHT   = imageLoad(u_HealthImage[pc.TextureIndex], localPx);
            uint  prevCenter = centerHT.r;
            uint  newCenter  = prevCenter;

            bool damagesTerrain = (proj.Type == 0u || proj.Type == 2u);
            if (damagesTerrain)
            {
                newCenter  = (proj.Damage >= newCenter) ? 0u : (newCenter - proj.Damage);
                centerHT.r = newCenter;

                if (newCenter == 0u)
                {
                    // destroyed: clear and arm destroyed effect
                    imageStore(u_InputTexture[pc.TextureIndex], localPx, vec4(0.0));
                    centerHT.g = 255u; // destroyed sentinel
                }
                // else: survivor gets NO effect (do not touch centerHT.g)
                imageStore(u_HealthImage[pc.TextureIndex], localPx, centerHT);
            }

            // ----- ray explosion -----
            // Rays travel through empty and terrain.
            // At destructible:
            //   - if damage < health: apply damage (no effect) and stop the ray
            //   - else destroy, set destroyed effect, keep going
            if (damagesTerrain)
            {
                const int RAY_DIRS = 16;
                const vec2 dirs[RAY_DIRS] = vec2[](
                    vec2( 1.0,  0.0), vec2(-1.0,  0.0), vec2( 0.0,  1.0), vec2( 0.0, -1.0),
                    vec2( 0.7071,  0.7071), vec2( 0.7071, -0.7071), vec2(-0.7071,  0.7071), vec2(-0.7071, -0.7071),
                    vec2( 0.9239,  0.3827), vec2( 0.9239, -0.3827), vec2(-0.9239,  0.3827), vec2(-0.9239, -0.3827),
                    vec2( 0.3827,  0.9239), vec2( 0.3827, -0.9239), vec2(-0.3827,  0.9239), vec2(-0.3827, -0.9239)
                );

                const int BRUSH = 2; // small brush to fill tiny gaps
                int  rpx    = int(proj.DestructionRadius);
                vec2 startP = vec2(localPx);

                for (int d = 0; d < RAY_DIRS; ++d)
                {
                    vec2  dir        = normalize(dirs[d]);
                    ivec2 lastStepPx = ivec2(0x7fffffff);

                    for (int s = 1; s <= rpx; ++s)
                    {
                        vec2  posF   = startP + dir * float(s);
                        ivec2 stepPx = ivec2(floor(posF + 0.5));
                        if (stepPx == lastStepPx)
                        {
                            continue;
                        }
                        lastStepPx = stepPx;

                        uint  stepSlot;
                        ivec2 stepLocal;
                        mapToNeighborSlot(stepPx, curSizeNow, stepSlot, stepLocal);
                        if (stepSlot == 0xffffffffu || stepSlot >= ACTIVE_SLOTS) break;

                        ivec2 stepSize = imageSize(u_InputTexture[stepSlot]);
                        if (stepLocal.x < 0 || stepLocal.y < 0 ||
                            stepLocal.x >= stepSize.x || stepLocal.y >= stepSize.y) break;

                        vec4  stepColor = imageLoad(u_InputTexture[stepSlot], stepLocal);
                        uvec4 stepHT    = imageLoad(u_HealthImage[stepSlot], stepLocal);
                        uint  stepH     = stepHT.r;

                        bool stepSolid     = (stepColor.a > 0.0);
                        bool stepDestruct  = (stepH > 0u);
                        bool stepImmutable = stepSolid && !stepDestruct;     // terrain
                        bool stepEmpty     = (!stepSolid) && (stepH == 0u);  // true empty

                        // Terrain: show impact (optional), do not block
                        if (stepImmutable)
                        {
                            if (stepHT.g == 0u)
                            {
                                stepHT.g = 254u; // impact sentinel for terrain
                                imageStore(u_HealthImage[stepSlot], stepLocal, stepHT);
                            }
                            continue;
                        }

                        // Empty: show impact, do not block
                        if (stepEmpty)
                        {
                            if (stepHT.g == 0u)
                            {
                                stepHT.g = 254u; // impact sentinel for empty
                                imageStore(u_HealthImage[stepSlot], stepLocal, stepHT);
                            }
                            continue;
                        }

                        // Destructible at this step
                        if (proj.Damage < stepH)
                        {
                            // Non-lethal: apply damage, no effect, ray stops here
                            stepHT.r = stepH - proj.Damage; // still > 0
                            imageStore(u_HealthImage[stepSlot], stepLocal, stepHT);
                            break;
                        }

                        // Destroyable: clear, set destroyed effect, and keep going
                        imageStore(u_InputTexture[stepSlot], stepLocal, vec4(0.0));
                        stepHT.r = 0u;
                        stepHT.g = 255u; // destroyed sentinel
                        imageStore(u_HealthImage[stepSlot], stepLocal, stepHT);

                        // Brush around the step to reduce gaps
                        for (int oy = -BRUSH; oy <= BRUSH; ++oy)
                        {
                            for (int ox = -BRUSH; ox <= BRUSH; ++ox)
                            {
                                if (ox*ox + oy*oy > BRUSH*BRUSH)
                                {
                                    continue;
                                }

                                ivec2 brushPx = stepPx + ivec2(ox, oy);

                                uint  brushSlot;
                                ivec2 brushLocal;
                                mapToNeighborSlot(brushPx, curSizeNow, brushSlot, brushLocal);
                                if (brushSlot == 0xffffffffu || brushSlot >= ACTIVE_SLOTS) continue;

                                ivec2 brushSize = imageSize(u_InputTexture[brushSlot]);
                                if (brushLocal.x < 0 || brushLocal.y < 0 ||
                                    brushLocal.x >= brushSize.x || brushLocal.y >= brushSize.y) continue;

                                vec4  bColor = imageLoad(u_InputTexture[brushSlot], brushLocal);
                                uvec4 bht    = imageLoad(u_HealthImage[brushSlot], brushLocal);
                                uint  bh     = bht.r;

                                bool bSolid     = (bColor.a > 0.0);
                                bool bDestruct  = (bh > 0u);
                                bool bImmutable = bSolid && !bDestruct; // terrain
                                bool bEmpty     = (!bSolid) && (bh == 0u);

                                if (bImmutable)
                                {
                                    // terrain: optional impact tag, no block
                                    if (bht.g == 0u)
                                    {
                                        bht.g = 254u;
                                        imageStore(u_HealthImage[brushSlot], brushLocal, bht);
                                    }
                                    continue;
                                }

                                if (bEmpty)
                                {
                                    // empty: optional impact tag
                                    if (bht.g == 0u)
                                    {
                                        bht.g = 254u;
                                        imageStore(u_HealthImage[brushSlot], brushLocal, bht);
                                    }
                                    continue;
                                }

                                // destructible neighbor
                                if (proj.Damage < bh)
                                {
                                    // apply damage, no effect, do not clear
                                    bht.r = bh - proj.Damage;
                                    imageStore(u_HealthImage[brushSlot], brushLocal, bht);
                                }
                                else
                                {
                                    // destroy neighbor
                                    imageStore(u_InputTexture[brushSlot], brushLocal, vec4(0.0));
                                    bht.r = 0u;
                                    bht.g = 255u;
                                    imageStore(u_HealthImage[brushSlot], brushLocal, bht);
                                }
                            }
                        }
                    }
                }
            }

            // Record result and exit
            results[i].hitProjectileID_Low  = proj.ID_Low;
            results[i].hitProjectileID_High = proj.ID_High;
            results[i].CollisionPosition    = worldPos;
            results[i].HealthAfter          = newCenter;
            atomicAdd(collisionCount, 1u);
            break;
        }



}
