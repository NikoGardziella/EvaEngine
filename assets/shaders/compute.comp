#type compute
#version 450

#define MAX_TEXTURES 32
#define MAX_COLLISION_ENTITIES 64
#define CHUNK_SIZE 32
#define SUBTILES_PER_TILE 4

layout(local_size_x = 16, local_size_y = 16) in;

// Texture bindings
layout(set = 0, binding = 0, rgba8) uniform image2D u_InputTexture[MAX_TEXTURES];
layout(set = 0, binding = 1, r8ui) uniform uimage2D u_HealthImage[MAX_TEXTURES];

// Collision result per projectile
struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _padding0;
    vec2 CollisionPosition;
    uint Health;
    uint _padding2;
};

struct ProjectileGPU {
    vec2 Position;
    float Radius;
    uint Type;
    uint ID_Low;
    uint ID_High;
    vec2 Size;
    float Rotation;
    uint Damage;
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer {
    uint collisionCount;
    uint _padding0;
    uint _padding1;
    uint _padding2;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles {
    ProjectileGPU data[];
};

// Optional blocking result: one uint per tile (flattened)
layout(std430, set = 0, binding = 4) buffer blockedTileMask {
    uint blockedMask[];
};

layout(push_constant) uniform PushConstants {
    vec2 TextureOrigin; // chunk offset in world space
    float PixelSize;
    uint TextureIndex;
    uint NumProjectiles;
    uint mode;         // 0 = Detect, 1 = Destroy, 2 = TileMask
    uint ChunkSize;    // in pixels (e.g. 512)
    uint TileSize;     // in pixels (e.g. 128)
    ivec2 MinTileCoords;
} pc;

bool PointInRotatedBox(vec2 point, vec2 boxCenter, vec2 halfSize, float rotation)
{
    vec2 local = point - boxCenter;
    float cosR = cos(rotation);
    float sinR = sin(rotation);
    vec2 rotated = vec2(
        cosR * local.x + sinR * local.y,
       -sinR * local.x + cosR * local.y
    );
    return abs(rotated.x) <= halfSize.x && abs(rotated.y) <= halfSize.y;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(u_InputTexture[pc.TextureIndex]);

    if (pixelCoord.x >= texSize.x || pixelCoord.y >= texSize.y)
        return;

    vec4 pixel = imageLoad(u_InputTexture[pc.TextureIndex], pixelCoord);
    if (pixel.a == 0.0)
        return;

    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    uvec4 healthPixel = imageLoad(u_HealthImage[pc.TextureIndex], pixelCoord);
    uint health = healthPixel.r;

    if (health > 0u)
    {
        vec2 worldPixelPos = vec2(pc.TextureOrigin) * float(pc.TileSize) + vec2(pixelCoord);

        vec2 tileWorldPos = worldPixelPos / float(pc.TileSize);
        ivec2 globalTileCoord = ivec2(floor(tileWorldPos));

        vec2 tileOriginWorld = vec2(globalTileCoord) * float(pc.TileSize);
        vec2 localInTile = worldPixelPos - tileOriginWorld;

        ivec2 subtileCoord = ivec2(floor(localInTile / (float(pc.TileSize) / float(SUBTILES_PER_TILE))));

        ivec2 globalSubtileCoord = globalTileCoord * SUBTILES_PER_TILE + subtileCoord;

        ivec2 relativeSubtileCoord = globalSubtileCoord - pc.MinTileCoords * SUBTILES_PER_TILE;

        // 3 means LOAD_RADIOUS in TextureStreaming is 1
        // which is 3x3 chunks around the player.
        const uint subtilesPerRow = CHUNK_SIZE * 3 * SUBTILES_PER_TILE;
        uint subtileIndex = uint(relativeSubtileCoord.y) * subtilesPerRow + uint(relativeSubtileCoord.x);

        // Mark this subtile as blocked
        atomicExchange(blockedMask[subtileIndex], 1);
    }



    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];
        bool collided = false;

        if (proj.Type == 0 || proj.Type == 1)
        {
            float dist = distance(worldPos, proj.Position);
            if (dist < proj.Radius)
                collided = true;
        }
        else if (proj.Type == 2)
        {
            if (PointInRotatedBox(worldPos, proj.Position, proj.Size * 0.5, proj.Rotation))
                collided = true;
        }

        

        if (collided)
        {
            if (health > 0u)
            {
                if (proj.Type == 0u || proj.Type == 2u)
                {
                    health = (proj.Damage > health) ? 0u : (health - proj.Damage);
                }

                imageStore(u_HealthImage[pc.TextureIndex], pixelCoord, uvec4(health, 0, 0, 0));

                if (health == 0u)
                {
                    imageStore(u_InputTexture[pc.TextureIndex], pixelCoord, vec4(0.0));
                }

                uint collisionIndex = atomicAdd(collisionCount, 1);
                if (collisionIndex < MAX_COLLISION_ENTITIES)
                {
                    results[collisionIndex].collisionDetected = 1;
                    results[collisionIndex].hitProjectileID_Low = proj.ID_Low;
                    results[collisionIndex].hitProjectileID_High = proj.ID_High;
                    results[collisionIndex].CollisionPosition = worldPos;
                    results[collisionIndex].Health = health;
                }
            }
        }
    }
}
