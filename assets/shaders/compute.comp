#type compute
#version 450
#include "ComputeUtils.glsl"

// ---------- config ----------
#define MAX_TEXTURES            32
#define MAX_COLLISION_ENTITIES  64
#define CHUNK_SIZE              32
#define SUBTILES_PER_TILE       4
#define GRID_WIDTH              3
#define GRID_HEIGHT             3
#define ACTIVE_SLOTS            (GRID_WIDTH * GRID_HEIGHT)
#define FLAG_GLOW_TERRAIN       1

#define PROJ_RADIUS_IS_WORLD  1
#define PROJ_RADIUS_IS_PIXELS 0

const uint FX_ARMED = 1u; // props.a bit0

layout(local_size_x = 16, local_size_y = 16) in;

// ---------- resources ----------
layout(set = 0, binding = 0, rgba8)   uniform  image2D  u_InputTexture[ACTIVE_SLOTS];
layout(set = 0, binding = 1, rgba8ui) uniform uimage2D u_PropertiesImage[ACTIVE_SLOTS]; // R=health, G=height (rows), B=timer, A=flags

struct CollisionResult {
    uint collisionDetected;     // per-proj claim tag (0 means unset). Appended hits use 1.
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _pad0;
    vec2 CollisionPosition;     // world pos of pixel center
    uint HealthAfter;
    uint _pad1;
};

// ---- MATCHES your CollisionEntitiesGPU byte layout exactly ----
struct ProjectileGPU {
    vec2  Position;            //   0..7
    float ColliderRadius;      //   8..11
    uint  Type;                //  12..15

    uint  ID_Low;              //  16..19
    uint  ID_High;             //  20..23

    vec2  Size;                //  24..31
    float Rotation;            //  32..35

    uint  Damage;              //  36..39
    uint  DestructionRadius;   //  40..43

    uint  _pad0;               //  44..47 (align EndPos to 8B)

    vec2  EndPos;              //  48..55
    vec2  Dir;                 //  56..63

    float RayLen;              //  64..67
    float Z1;                  //  68..71
};

layout(std430, set = 0, binding = 2) buffer ResultBuffer {
    uint collisionCount; uint _padA; uint _padB; uint _padC;
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

layout(std430, set = 0, binding = 3) readonly buffer Projectiles { ProjectileGPU data[]; };
layout(std430, set = 0, binding = 4) buffer BlockedTileMask      { uint blockedMask[]; };

// ---------- push constants ----------
layout(push_constant) uniform PushConstants {
    vec2  TextureOriginWorld;  // world origin of this slot
    float PixelSizeWorld;      // world units / pixel
    uint  TextureIndex;        // 0..8

    uint  NumProjectiles;
    uint  Mode;                // lower 2 bits = falloff mode
    uint  ChunkSizePixels;     // e.g. 512
    uint  TileSizePixels;      // e.g. 128

    ivec2 MinChunkCoords;      // unused here
} pc;

// ---------- helpers ----------
uvec4 loadHT(uint slot, ivec2 px)            { return imageLoad(u_PropertiesImage[slot], px); }
void  storeHT(uint slot, ivec2 px, uvec4 ht) { imageStore(u_PropertiesImage[slot], px, ht); }
void  clearColor(uint slot, ivec2 px)        { imageStore(u_InputTexture[slot], px, vec4(0.0)); }

bool hasHealth(uvec4 ht) { return (ht.r > 0u); }

// Health-only blocked mask (3x3 window, per-subtile)
void writeBlockedMaskIfNeeded(ivec2 localPx)
{
    int tileSize = int(pc.TileSizePixels);
    ivec2 tileInChunk = localPx / tileSize;
    ivec2 pxInTile    = localPx - tileInChunk * tileSize;

    int subDiv        = max(1, tileSize / SUBTILES_PER_TILE);
    ivec2 subtile     = ivec2(pxInTile.x / subDiv, pxInTile.y / subDiv);

    int gridW = GRID_WIDTH, gridH = GRID_HEIGHT;
    int cx = int(pc.TextureIndex % uint(gridW));
    int cy = int(pc.TextureIndex / uint(gridW));

    ivec2 windowTile = ivec2(cx * CHUNK_SIZE + tileInChunk.x,
                             cy * CHUNK_SIZE + tileInChunk.y);

    const int subtilesPerRow = GRID_WIDTH  * CHUNK_SIZE * SUBTILES_PER_TILE;
    const int subtilesRows   = GRID_HEIGHT * CHUNK_SIZE * SUBTILES_PER_TILE;

    int ix = windowTile.x * SUBTILES_PER_TILE + subtile.x;
    int iy = windowTile.y * SUBTILES_PER_TILE + subtile.y;

    if (ix >= 0 && iy >= 0 && ix < subtilesPerRow && iy < subtilesRows) {
        uint idx = uint(iy) * uint(subtilesPerRow) + uint(ix);
        atomicExchange(blockedMask[idx], 1u);
    }
}

// Map to neighboring 3x3 slot
void mapToNeighborSlot(ivec2 localPx, ivec2 curTexSize,
                       out uint writeSlot, out ivec2 writePx)
{
    int gridW = GRID_WIDTH, gridH = GRID_HEIGHT;
    int cx = int(pc.TextureIndex % uint(gridW));
    int cy = int(pc.TextureIndex / uint(gridW));

    int sx = 0, sy = 0;
    ivec2 p = localPx;

    if      (p.x < 0)             { sx = -1; p.x += curTexSize.x; }
    else if (p.x >= curTexSize.x) { sx = +1; p.x -= curTexSize.x; }
    if      (p.y < 0)             { sy = -1; p.y += curTexSize.y; }
    else if (p.y >= curTexSize.y) { sy = +1; p.y -= curTexSize.y; }

    int nx = cx + sx, ny = cy + sy;
    if (nx < 0 || nx >= gridW || ny < 0 || ny >= gridH) {
        writeSlot = 0xffffffffu; writePx = ivec2(0); return;
    }
    writeSlot = uint(ny * gridW + nx);
    writePx   = p;
}

// Circle/box overlap against *pixel cell*
bool projectileHitByType(const ProjectileGPU proj, ivec2 localPx)
{
    // pixel center in world
    vec2  P  = pc.TextureOriginWorld + (vec2(localPx) + vec2(0.5)) * pc.PixelSizeWorld;
    float H  = 0.5 * pc.PixelSizeWorld; // half cell in world

#if PROJ_RADIUS_IS_WORLD
    float Rw = proj.ColliderRadius;
#else
    float Rw = proj.ColliderRadius * pc.PixelSizeWorld;
#endif

    if (isProjectile(proj.Type))
    {
        // circle vs cell (no sqrt)
        vec2 q = abs(proj.Position - P) - vec2(H);
        vec2 m = max(q, 0.0);
        return dot(m, m) <= Rw * Rw;
    }
    else if (isVehicle(proj.Type))
    {
        // rotated AABB vs point
        float cs = cos(proj.Rotation), sn = sin(proj.Rotation);
        vec2  d  = P - proj.Position;
        vec2  q2 = vec2(cs*d.x + sn*d.y, -sn*d.x + cs*d.y);
        vec2  h  = proj.Size * 0.5;
        return (abs(q2.x) <= h.x) && (abs(q2.y) <= h.y);
    }
    return false;
}

// ---------- results / claim ----------
uint appendBase() { return pc.NumProjectiles; }

uint hashProjTag(uint lo, uint hi)
{
    uint h = 0x9E3779B9u ^ lo;
    h ^= hi + 0x85EBCA6Bu + (h << 6) + (h >> 2);
    h *= 0xC2B2AE35u;
    h ^= (h >> 16);
    return (h | 1u); // never 0
}

// One-shot claim per projectile across the dispatch
bool claimCollisionOnce(uint i, uint tag)
{
    if (i >= pc.NumProjectiles || i >= MAX_COLLISION_ENTITIES) return false;
    uint old = atomicExchange(results[i].collisionDetected, tag);
    return (old != tag);
}

void writeCollisionResult(const ProjectileGPU proj, vec2 worldPos, uint healthAfter)
{
    uint idx = atomicAdd(collisionCount, 1u);
    uint dst = appendBase() + idx;
    if (dst >= MAX_COLLISION_ENTITIES) return;

    results[dst].collisionDetected    = 1u;
    results[dst].hitProjectileID_Low  = proj.ID_Low;
    results[dst].hitProjectileID_High = proj.ID_High;
    results[dst].CollisionPosition    = worldPos;
    results[dst].HealthAfter          = healthAfter;
}

// ---------- FX/damage helpers ----------
void rearmGlow_fx(bool fx, uint slot, ivec2 px, inout uvec4 ht, uint seed)
{
    if (!fx) return;
    uint s = min(seed, 255u);
    if (ht.b < s) ht.b = s;       // start/refresh timer
    ht.a |= FX_ARMED;
    storeHT(slot, px, ht);
}

void destroyPixel_fx(bool fx, uint slot, ivec2 px, inout uvec4 ht)
{
    clearColor(slot, px);
    ht.r = 0u;                    // dead
    if (fx) {
        uint s = min(20u, 255u);
        if (ht.b < s) ht.b = s;   // FX on destroyed
        ht.a |= FX_ARMED;
    }
    storeHT(slot, px, ht);
}

// *** partial damage does NOT arm FX (effect stops on partial) ***
void applyDamage_fx(bool /*fx*/, uint slot, ivec2 px, inout uvec4 ht, uint damage)
{
    uint h = ht.r;
    if (damage >= h) {
        clearColor(slot, px);
        ht.r = 0u;
        storeHT(slot, px, ht);
    } else {
        ht.r = h - damage;
        storeHT(slot, px, ht);
    }
}

// ---------- falloff ----------
uint getFalloffMode() { return pc.Mode & 0x3u; }

float falloffWeight(float t, uint mode)
{
    t = clamp(t, 0.0, 1.0);
    if (mode == 0u) return 1.0;                    // flat
    if (mode == 1u) return 1.0 - t;                // linear
    if (mode == 2u) { float w = 1.0 - t; return w*w; } // quadratic
    // inverse-square (clamped)
    const float eps = 0.05;
    float x = max(t, eps);
    float w = (1.0 / (x*x)) / (1.0 / (eps*eps));
    return clamp(w, 0.0, 1.0);
}

// Explosion via many short rays. **Stops on partial**.
void processExplosionDiskFalloff(const ProjectileGPU proj, bool fx, ivec2 centerPx, ivec2 curSize)
{
    int r = int(proj.DestructionRadius);
    if (r <= 0) return;

    uint  mode     = getFalloffMode();
    float twoPi    = 6.28318530718;
    int   rayCount = max(32, int(ceil(twoPi * float(r) * 1.0)));
    const int BRUSH = 5;

    for (int d = 0; d < rayCount; ++d)
    {
        float ang = (twoPi * (float(d) + 0.5)) / float(rayCount);
        vec2  dir = vec2(cos(ang), sin(ang));

        for (int s = 1; s <= r; ++s)
        {
            vec2  posF = vec2(centerPx) + dir * float(s);
            ivec2 p    = ivec2(floor(posF + 0.5));

            uint  slot; ivec2 local;
            mapToNeighborSlot(p, curSize, slot, local);
            if (slot == 0xffffffffu || slot >= ACTIVE_SLOTS) break;

            ivec2 sz = imageSize(u_InputTexture[slot]);
            if (local.x < 0 || local.y < 0 || local.x >= sz.x || local.y >= sz.y) break;

            vec4  col = imageLoad(u_InputTexture[slot], local);
            uvec4 ht  = loadHT(slot, local);
            bool  hasHP   = hasHealth(ht);
            bool  empty   = (col.a <= 0.0) && !hasHP;
            bool  terrain = (col.a >  0.0) && !hasHP;

            if (empty)
            {
                // cosmetic scorch along the path
                rearmGlow_fx(fx, slot, local, ht, 20u);
                continue;
            }

            if (terrain)
            {
                if ((FLAG_GLOW_TERRAIN) != 0u)
                {
                    rearmGlow_fx(fx, slot, local, ht, 20u);
                }
                break; // stop on terrain
            }

            // Live texel: compute falloff damage
            float t   = float(s) / float(r);
            float w   = falloffWeight(t, mode);
            uint  dmg = uint(floor(float(proj.Damage) * w + 0.5));
            if (dmg == 0u) break; // stop when too weak to matter

            if (dmg < ht.r)
            {
                // *** Partial: apply damage and STOP — no FX arming here ***
                applyDamage_fx(false, slot, local, ht, dmg);
                break;
            }
            else
            {
                // Destroy and keep going a bit (small brush), then continue the ray
                destroyPixel_fx(fx, slot, local, ht);

                for (int oy = -BRUSH; oy <= BRUSH; ++oy)
                for (int ox = -BRUSH; ox <= BRUSH; ++ox)
                {
                    if (ox*ox + oy*oy > BRUSH*BRUSH) continue;

                    ivec2 bp = p + ivec2(ox, oy);
                    uint  bslot; ivec2 bloc;
                    mapToNeighborSlot(bp, sz, bslot, bloc);
                    if (bslot == 0xffffffffu || bslot >= ACTIVE_SLOTS) continue;

                    ivec2 bsz = imageSize(u_InputTexture[bslot]);
                    if (bloc.x < 0 || bloc.y < 0 || bloc.x >= bsz.x || bloc.y >= bsz.y) continue;

                    vec4  bcol = imageLoad(u_InputTexture[bslot], bloc);
                    uvec4 bht  = loadHT(bslot, bloc);
                    bool  bHas = hasHealth(bht);
                    bool  bTer = (bcol.a > 0.0) && !bHas;

                    if (bTer)
                    {
                        // optional: leave it
                    }
                    else if (!bHas)
                    {
                        rearmGlow_fx(fx, bslot, bloc, bht, 20u);
                    }
                    else
                    {
                        uint bdmg = max(1u, dmg / 2u);
                        if (bdmg < bht.r)
                        {
                            applyDamage_fx(false, bslot, bloc, bht, bdmg);
                        }
                        else
                        {
                            destroyPixel_fx(fx,   bslot, bloc, bht);
                        }
                    }
                }
            }
        }
    }
}

// ---------- main ----------
void main()
{
    if (pc.TextureIndex >= ACTIVE_SLOTS) return;

    ivec2 localPx = ivec2(gl_GlobalInvocationID.xy);
    ivec2 curSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (localPx.x >= curSize.x || localPx.y >= curSize.y) return;

    // world center for this pixel (for reporting)
    vec2 worldPos = pc.TextureOriginWorld + (vec2(localPx) + vec2(0.5)) * pc.PixelSizeWorld;

    // health & blocked mask
    uvec4 centerHT     = loadHT(pc.TextureIndex, localPx);
    uint  centerHealth = centerHT.r;
    bool  centerHasHP  = (centerHealth > 0u);
    if (centerHasHP) { writeBlockedMaskIfNeeded(localPx); }

    // Z-gate constants (use same units as your height encoding)
    const float EPS_Z       = 1e-5;
    const float MIN_SOLID_Z = 0.1 * pc.PixelSizeWorld;
    const float Z_FIXED     = 0.5; // launch height; keep as before (no new push constants)

    // test all projectiles
    for (uint i = 0u; i < pc.NumProjectiles; ++i)
    {
        ProjectileGPU proj = data[i];
        bool fx = isProjectile(proj.Type); // vehicles do not spawn FX

        // per-pixel overlap for this slot
        if (!projectileHitByType(proj, localPx)) continue;

        // --- NEW: Z-ray gating for projectiles only (preserves previous behavior otherwise) ---
        if (isProjectile(proj.Type))
        {
            // segment from muzzle -> end
            vec2 muzzle = proj.EndPos - proj.Dir * proj.RayLen;

            // param of THIS pixel along the ray [0..1]
            float tPixel = clamp(
                dot(worldPos - muzzle, proj.Dir) / max(proj.RayLen, 1e-6),
                0.0, 1.0);

            // ray height at this pixel
            float zRay = mix(Z_FIXED, proj.Z1, tPixel);

            // texel height (rows-above-pivot in props.g -> world units)
            float hW = float(centerHT.g) * pc.PixelSizeWorld;
            if (hW < MIN_SOLID_Z) hW = 0.0;

            // only collide if ray is at/below surface
            if (zRay > hW + EPS_Z)
            {
                continue; // above the surface  no hit here
            }
        }
        // --------------------------------------------------------------------

        // only collidable if alive
        if (!centerHasHP)
        {
            // (keep old behavior: do nothing here; empty-texel FX handled in explosion rays)
            continue;
        }

        // per-projectile one-shot claim
        uint projTag = hashProjTag(proj.ID_Low, proj.ID_High);
        if (!claimCollisionOnce(i, projTag)) continue;

        // winner: apply damage at center and spawn explosion rays that STOP on partial
        centerHT = loadHT(pc.TextureIndex, localPx);
        if (proj.Damage < centerHT.r)
        {
            // partial at center  apply and STOP (no FX on partial)
            applyDamage_fx(false, pc.TextureIndex, localPx, centerHT, proj.Damage);
            processExplosionDiskFalloff(proj, fx, localPx, curSize);
        }
        else
        {
            // destroy center  FX + rays
            destroyPixel_fx(fx, pc.TextureIndex, localPx, centerHT);
            processExplosionDiskFalloff(proj, fx, localPx, curSize);
        }

        // append one hit for CPU
        writeCollisionResult(proj, worldPos, centerHT.r);
        break; // stop other projectiles for this pixel
    }
}
