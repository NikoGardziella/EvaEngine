#type compute
#version 450

#define MAX_TEXTURES 32
#define MAX_COLLISION_ENTITIES 64

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform image2D u_InputTexture[MAX_TEXTURES];
layout(binding = 1, rgba8) uniform image2D u_OutputTexture[MAX_TEXTURES];

struct CollisionResult {
    uint collisionDetected;
    uint hitProjectileID_Low;
    uint hitProjectileID_High;
    uint _padding1;
    vec2 CollisionPosition;
    uint _padding2;
    uint _padding3;

};

struct ProjectileGPU {
    vec2 Position;
    float Radius;
    uint Type;      // 0 = projectile, 1 = player
    uint ID_Low;
    uint ID_High;
    uint _padding0; 
    uint _padding1; 
};

// Results SSBO
layout(std430, binding = 2) buffer ResultBuffer {
    uint collisionCount;
    uint _padding0; 
    uint _padding1; 
    uint _padding2; 
    CollisionResult results[MAX_COLLISION_ENTITIES];
};

// Projectiles SSBO
layout(std140, set = 0, binding = 3) readonly buffer Projectiles {
    ProjectileGPU data[];
};

// Push constants
layout(push_constant) uniform PushConstants
{
    vec2 TextureOrigin;
    float PixelSize;
    uint TextureIndex;
    uint NumProjectiles;
    uint mode; // 0 = Detect, 1 = Destroy
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    // Bounds check
    ivec2 textureSize = imageSize(u_InputTexture[pc.TextureIndex]);
    if (pixelCoord.x >= textureSize.x || pixelCoord.y >= textureSize.y)
        return;

    vec4 pixel = imageLoad(u_InputTexture[pc.TextureIndex], pixelCoord);
    if (pixel.a == 0.0)
        return;

   
    vec2 worldPos = pc.TextureOrigin + vec2(pixelCoord) * pc.PixelSize;

    for (uint i = 0; i < pc.NumProjectiles; ++i)
    {
        vec2 projectilePos = data[i].Position;
        float radius = data[i].Radius;
        uint type = data[i].Type;

        float collisionRadius = radius / 10.0f;
        float dist = distance(worldPos, projectilePos);
        if (dist < radius)
        {

           
            if (type == 0)
            {
                imageStore(u_OutputTexture[pc.TextureIndex], pixelCoord, vec4(0, 0, 0, 0));
            }
            if(type == 1)
            {
                // debug
               // imageStore(u_OutputTexture[pc.TextureIndex], pixelCoord, vec4(0.9f, 0.1f, 0.1f, 1));
            }

            //if(dist < collisionRadius)
            {
                
                uint index = atomicAdd(collisionCount, 1);
                results[index].collisionDetected = 1;
                results[index].hitProjectileID_Low = data[i].ID_Low;
                results[index].hitProjectileID_High = data[i].ID_High;
                results[index].CollisionPosition = worldPos;
                
            }
           
        }
    }
}
