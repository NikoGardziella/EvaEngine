#type compute
#version 450
#define GRID_WIDTH 3
#define GRID_HEIGHT 3
#define ACTIVE_SLOTS (GRID_WIDTH*GRID_HEIGHT)
layout(local_size_x=16, local_size_y=16) in;

layout(set=0,binding=0, rgba8)   uniform  image2D  u_InputTexture[ACTIVE_SLOTS]; // color
layout(set=0,binding=1, rgba8ui) uniform uimage2D u_Props       [ACTIVE_SLOTS];  // R=health, G=height, B=fxTimer, A=fxPrevK

layout(push_constant) uniform EffectPushConstants
{
    vec2  textureOrigin;
    float pixelSize;
    uint  textureIndex;

    uint  defaultTimer;      // e.g. 48..96
    float glowStrength;      // 0..1
    uint  maxTimer;          // clamp cap
    uint  flags;             // (unused here)

    vec4  impactTint;        // rgb
    vec4  destroyedTint;     // unused
    vec4  flashTint;         // reserved

    vec4  effectParams0;     // x=flashStrength, y=flickerAmount, z=alphaLiftEmpty, w=curveBoost
} pc;

uint expandTimer(uint t0)
{
    if (t0 == 255u) return max(pc.defaultTimer, 1u);
    if (t0 == 254u) return max(pc.defaultTimer/2u, 1u);
    return t0;
}

float strengthFromTimer(uint tcur)
{
    float w = float(tcur) / float(max(pc.maxTimer, 1u));
    float k = max(1.6*w - 0.6*w*w, 0.0);
    return k * pc.effectParams0.w;
}

float noiseF(ivec2 p, uint t)
{
    return fract(sin(dot(vec3(p, int(t)), vec3(12.9898,78.233,37.719))) * 43758.5453);
}

void main()
{
    uint si = pc.textureIndex;
    if (si >= ACTIVE_SLOTS) return;

    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz  = imageSize(u_Props[si]);
    if (gid.x >= sz.x || gid.y >= sz.y) return;

    // State + base color
    uvec4 state   = imageLoad(u_Props[si], gid);   // R=health, G=height, B=fxTimer, A=fxPrevK
    vec4  baseCol = imageLoad(u_InputTexture[si], gid);

    uint  health  = state.r;
    uint  timer0  = state.b;   // 0=no FX, 254/255 = seed, 1..maxTimer = running
    uint  prevK8  = state.a;

    // If no FX requested but a residual k_prev is present, undo it once and clear.
    if (timer0 == 0u && prevK8 != 0u)
    {
        float k_prev = float(prevK8) / 255.0;
        vec3  tint   = pc.impactTint.rgb;                 // same tint we added before
        vec3  rgbOut = clamp(baseCol.rgb - k_prev * tint, 0.0, 1.0);
        imageStore(u_InputTexture[si], gid, vec4(rgbOut, baseCol.a));
        state.a = 0u;
        imageStore(u_Props[si], gid, state);
        return;
    }

    // If no FX at all, nothing to do.
    if (timer0 == 0u) return;

    // Expand sentinels and clamp
    uint timerCur = (timer0 == 255u) ? max(pc.defaultTimer, 1u)
                 : (timer0 == 254u) ? max(pc.defaultTimer / 2u, 1u)
                 :                     timer0;
    timerCur = min(timerCur, pc.maxTimer);

    bool firstArm = (timer0 >= 254u);
    bool destroyedPath = (health == 0u) || (baseCol.a < 0.01);

    // Strength k(t)
    float w      = float(timerCur) / float(max(pc.maxTimer, 1u));
    float kCurve = max(1.6*w - 0.6*w*w, 0.0) * pc.effectParams0.w;
    if (firstArm) kCurve = clamp(kCurve + pc.effectParams0.x, 0.0, 1.0);

    float n     = fract(sin(dot(vec3(gid, int(timerCur)), vec3(12.9898,78.233,37.719))) * 43758.5453);
    float k_cur = clamp(pc.glowStrength *
                        mix(kCurve * (1.0 - pc.effectParams0.y),
                            kCurve * (1.0 + pc.effectParams0.y), n),
                        0.0, 1.0);

    float k_prev  = firstArm ? 0.0 : float(prevK8) / 255.0;
    bool  lastTick = (timerCur <= 1u);
    float k_write  = lastTick ? 0.0 : k_cur;   // write 0 on last tick to self-clean

    // Tint & optional alpha lift for destroyed flashes
    vec3  tint   = destroyedPath ? pc.destroyedTint.rgb : pc.impactTint.rgb;
    float aLift  = (destroyedPath ? pc.effectParams0.z : 0.0);  // lift alpha only on destroyed/empty

    // Reversible delta write
    vec3  rgbOut = clamp(baseCol.rgb + (k_write - k_prev) * tint, 0.0, 1.0);
    float aOut   = clamp(baseCol.a  + (k_write - k_prev) * aLift, 0.0, 1.0);

    // If we’re on the last tick of a destroyed flash, force alpha back to 0
    if (destroyedPath && lastTick) aOut = 0.0;

    imageStore(u_InputTexture[si], gid, vec4(rgbOut, aOut));

    // Persist state: zero both when the effect finishes
    state.b = lastTick ? 0u : (timerCur - 1u);                          // fxTimer
    state.a = lastTick ? 0u : uint(round(clamp(k_cur, 0.0, 1.0) * 255.0)); // fxPrevK
    imageStore(u_Props[si], gid, state);
}


