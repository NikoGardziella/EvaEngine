#type compute
#version 450

#define MAX_TEXTURES 32
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8)   uniform  image2D  u_InputTexture[MAX_TEXTURES];
layout(set = 0, binding = 1, rgba8ui) uniform uimage2D u_HealthImage[MAX_TEXTURES];

layout(push_constant) uniform PC {
    vec2  textureOrigin;
    float pixelSize;
    uint  textureIndex;
    uint  defaultTimer;   // seed for destroyed
    float glowStrength;   // recommend ~0.4..0.9
    uint  maxTimer;       // clamp/normalize timeline
    uint  _pad0;
} pc;

void main()
{
    ivec2 gid  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_HealthImage[pc.textureIndex]);
    if (gid.x >= size.x || gid.y >= size.y)
        return;

    // r = health (0..255), g = timer/sentinel (0 idle, 254 impact, 255 destroyed, else live countdown)
    uvec4 hp = imageLoad(u_HealthImage[pc.textureIndex], gid);
    uint  H  = hp.r;
    uint  T  = hp.g;

    // Convert sentinels -> live timers (single-shot)
    uint hitTimer = max(pc.defaultTimer / 2u, 1u);
    if (T == 255u)
        T = min(pc.defaultTimer, pc.maxTimer);
    else if (T == 254u)
        T = min(hitTimer, pc.maxTimer);

    if (T > 0u)
    {
        // Read current color (may be zero if center was cleared by destruction)
        vec4 base = imageLoad(u_InputTexture[pc.textureIndex], gid);

        // Smooth fade weight
        float tf = float(T) / float(max(pc.maxTimer, 1u)); // 0..1
        float w  = tf * tf;

        // Pure color glow — no transparency during the effect
        const vec3 glowDestroyed = vec3(1.00, 0.55, 0.15); // orange
        const vec3 glowImpact    = vec3(1.00, 0.90, 0.25); // yellow
        vec3 glowColor           = (H == 0u) ? glowDestroyed : glowImpact;

        // Additive tint; clamp to 1.0
        vec3 outRGB = clamp(base.rgb + glowColor * (pc.glowStrength * w), 0.0, 1.0);

        // Force visible alpha during the glow so it’s never “see-through”
        float outA = 1.0;

        imageStore(u_InputTexture[pc.textureIndex], gid, vec4(outRGB, outA));

        // countdown
        T -= 1u;
    }
    else
    {
        // Timer finished: if the pixel is truly destroyed, keep it clear; otherwise leave as-is
        if (H == 0u)
            imageStore(u_InputTexture[pc.textureIndex], gid, vec4(0.0));
    }

    // Persist updated timer
    hp.g = T;
    imageStore(u_HealthImage[pc.textureIndex], gid, hp);
}
