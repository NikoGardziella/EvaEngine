#type compute
#version 450
#define GRID_WIDTH 3
#define GRID_HEIGHT 3
#define ACTIVE_SLOTS (GRID_WIDTH*GRID_HEIGHT)
layout(local_size_x=16, local_size_y=16) in;

layout(set=0,binding=0, rgba8)   uniform  image2D  u_InputTexture[ACTIVE_SLOTS];  // color
layout(set=0,binding=1, rgba8ui) uniform uimage2D u_StateImage [ACTIVE_SLOTS];    // R=health, G=timer, B=mask, A=k_prev

layout(push_constant) uniform PC {
    vec2  textureOrigin;  float pixelSize;   uint  textureIndex;
    uint  defaultTimer;   float glowStrength; uint  maxTimer; uint  flags;
    vec4  impactTint;     vec4 destroyedTint; vec4  flashTint;
    vec4  effectParams0; // x=flash, y=flicker, z=alphaLiftEmpty, w=curveBoost
} pc;

#define FLAG_GLOW_TERRAIN      (1u<<0)
#define FLAG_ALPHA_LIFT_EMPTY  (1u<<1)

void main(){
    if (pc.textureIndex >= ACTIVE_SLOTS) return;
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);

    ivec2 sz = imageSize(u_StateImage[pc.textureIndex]);
    if (gid.x>=sz.x || gid.y>=sz.y) return;

    // Read state (R=health, G=timer, B=mask, A=k_prev)
    uvec4 st = imageLoad(u_StateImage[pc.textureIndex], gid);
    uint H   = st.r;
    uint T0  = st.g;
    uint M   = st.b; // mask, MUST preserve
    uint Kp8 = st.a; // previous strength 0..255

    // Base color (already has previous effect applied)
    vec4 base = imageLoad(u_InputTexture[pc.textureIndex], gid);

    bool isEmpty   = (base.a < 0.01);
    bool isTerrain = (!isEmpty) && (H == 0u);

    // Expand sentinel -> active timer
    uint impactSeed = max(pc.defaultTimer/2u, 1u);
    uint Tcur = (T0==255u) ? pc.defaultTimer :
                (T0==254u) ? impactSeed      : T0;
    Tcur = min(Tcur, pc.maxTimer);
    if (Tcur == 0u){
        // keep baselines zeroed; PRESERVE MASK!
        st.g = 0u; st.a = 0u;           // timer, k_prev
        st.b = M;                       // mask unchanged
        imageStore(u_StateImage[pc.textureIndex], gid, st);
        return;
    }

    bool firstArm = (T0==254u || T0==255u);
    float k_prev = firstArm ? 0.0 : float(Kp8)/255.0;

    // Strength curve
    float w   = float(Tcur)/float(max(pc.maxTimer,1u));
    float k0  = max(1.6*w - 0.6*w*w, 0.0) * pc.effectParams0.w;
    if (firstArm) k0 = clamp(k0 + pc.effectParams0.x, 0.0, 1.0);

    // Flicker
    float n = fract(sin(dot(vec3(gid, float(Tcur)), vec3(12.9898,78.233,37.719))) * 43758.5453);
    float k_cur = clamp(pc.glowStrength * k0 * mix(1.0 - pc.effectParams0.y, 1.0 + pc.effectParams0.y, n), 0.0, 1.0);

    // Tint selection
    bool destroyedVisual = isEmpty && (H==0u);
    vec3 tint = destroyedVisual ? pc.destroyedTint.rgb : pc.impactTint.rgb;

    // Reversible color write
    vec3 outRgb = clamp(base.rgb + (k_cur - k_prev) * tint, 0.0, 1.0);

    // Alpha lift (reconstruct a_prev from k_prev)
    float outA = base.a;
    if (!isTerrain){
        bool liftEmpty = ((pc.flags & FLAG_ALPHA_LIFT_EMPTY)!=0u);
        float a_prev = (firstArm || !liftEmpty || !destroyedVisual) ? 0.0 : k_prev * pc.effectParams0.z;
        float a_cur  = (liftEmpty && destroyedVisual) ? (k_cur * pc.effectParams0.z) : 0.0;
        outA = clamp(base.a + (a_cur - a_prev), 0.0, 1.0);
    }

    // Write color
    imageStore(u_InputTexture[pc.textureIndex], gid, vec4(outRgb, outA));

    // Persist timer and k_prev — PRESERVE mask and health
    st.g = Tcur - 1u;                                       // timer
    st.a = uint(clamp(round(k_cur * 255.0), 0.0, 255.0));   // k_prev
    st.b = M;                                               // mask unchanged
    // (optional) zero k_prev when done
    if (st.g == 0u) st.a = 0u;

    imageStore(u_StateImage[pc.textureIndex], gid, st);
}
