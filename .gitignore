## --- IDE & OS ---
.vs/
*.VC.db
*.VC.VC.opendb
.DS_Store
Thumbs.db
desktop.ini

## --- Build Artifacts (Global) ---
# These are generated by Premake/Compiler
bin/
bin-obj/
bin-intermediate/
build/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.recipe
*.tlog
*.ilk
*.pdb
*.idb
*.ipch

## --- Engine Specific Cache ---
# Using ** to catch these regardless of path depth
**/tile_cache/
**/chunk_cache/
*.tile
*.enc
**/trace/
EvaEngineProfile-*.json

## --- Third Party / Vendor ---
# 1. vcpkg tool artifacts (when using vcpkg as a submodule)
EvaEngine/vendor/vcpkg/vcpkg.exe
EvaEngine/vendor/vcpkg/vcpkg
EvaEngine/vendor/vcpkg/buildtrees/
EvaEngine/vendor/vcpkg/packages/
EvaEngine/vendor/vcpkg/downloads/
EvaEngine/vendor/vcpkg/installed/

# 2. Your specific install root (The clean root approach)
vcpkg_installed/
EvaEngine/vendor/vcpkg_installed/

# 3. Other SDKs
EvaEngine/vendor/VulkanSDK/

## --- Binary Extensions (Global Catch-all) ---
# Useful as a safety net
*.exe
*.dll
*.lib
*.pdb
*.obj
*.o
*.pch
*.gch